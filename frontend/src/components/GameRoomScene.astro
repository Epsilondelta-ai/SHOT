---
import character from '../assets/character.webp';
import { type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';

interface Props {
  apiUrl: string;
  lang: Locale;
}

const { apiUrl, lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="scene-gameroom" class="hidden relative z-10 w-full flex-1 flex-col overflow-hidden min-h-0">
  <div class="flex flex-col sm:flex-row flex-1 min-h-0 max-w-5xl mx-auto w-full px-4 py-4 gap-4">

    <!-- Left panel -->
    <div class="flex flex-col gap-3 sm:w-72 flex-shrink-0">

      <!-- Room header -->
      <div class="flex items-center gap-2">
        <button id="leave-room-btn" class="bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-xl text-sm transition">
          ← {t.rooms.leaveRoom}
        </button>
        <div class="ml-auto flex gap-2">
          <button id="edit-room-btn" class="hidden bg-white/10 hover:bg-white/20 text-white px-2 py-1.5 rounded-xl text-xs transition" title={t.rooms.editRoom}>✏️</button>
          <button id="start-game-btn" class="hidden bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-3 py-1.5 rounded-xl text-sm transition">{t.rooms.startGame}</button>
        </div>
      </div>

      <!-- Room info -->
      <div class="bg-black/40 rounded-2xl px-4 py-3">
        <h2 id="gameroom-name" class="text-white font-bold text-base truncate mb-1"></h2>
        <div class="flex items-center gap-2 flex-wrap">
          <span id="gameroom-status-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full"></span>
          <span id="gameroom-private-badge" class="hidden text-xs text-amber-300"><img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Objects/Locked.png" alt="Locked" class="inline-block w-4 h-4" /> {t.rooms.privateRoom}</span>
        </div>
      </div>

      <!-- Players -->
      <div class="bg-black/40 rounded-2xl p-3 flex-1">
        <p class="text-white/50 text-xs font-semibold uppercase tracking-wider mb-2">
          {t.rooms.players} <span id="gameroom-player-count" class="text-white/70"></span>
        </p>
        <div id="gameroom-slots" class="grid grid-cols-3 gap-2 mb-3"></div>

        <!-- Spectators -->
        <div id="gameroom-spectator-section" class="hidden mt-2 pt-2 border-t border-white/10">
          <p class="text-white/40 text-xs font-semibold uppercase tracking-wider mb-2"><img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Hand%20gestures/Eye.png" alt="Eye" class="inline-block w-4 h-4" /> {t.rooms.spectators}</p>
          <div id="gameroom-spectator-slots" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <!-- Bottom actions -->
      <div class="flex flex-col gap-2">
        <button id="spectate-btn" class="w-full bg-white/10 hover:bg-white/20 text-white py-2 rounded-xl text-sm transition">{t.rooms.spectate}</button>
        <button id="invite-bot-btn" class="hidden w-full bg-blue-500/20 hover:bg-blue-500/30 text-blue-300 py-2 rounded-xl text-sm transition"><img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Smilies/Robot.png" alt="bot" class="inline-block w-4 h-4" /> {t.rooms.inviteBot}</button>
      </div>
    </div>

    <!-- Right panel: Chat -->
    <div class="flex flex-col flex-1 min-h-0 bg-black/40 rounded-2xl overflow-hidden">
      <div class="px-4 py-3 border-b border-white/10">
        <p class="text-white/60 text-sm font-semibold">{t.rooms.chat}</p>
      </div>
      <div id="chat-messages" class="flex-1 overflow-y-auto p-4 flex flex-col gap-2 min-h-0"></div>
      <div class="flex gap-2 p-3 border-t border-white/10">
        <input id="chat-input" type="text" maxlength="300"
          placeholder={t.rooms.chatPlaceholder}
          class="flex-1 bg-white/10 border border-white/20 rounded-xl px-4 py-2 text-white placeholder-white/30 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400" />
        <button id="chat-send-btn" class="bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-4 py-2 rounded-xl text-sm transition">{t.rooms.chatSend}</button>
      </div>
    </div>
  </div>
</div>

<!-- Player action modal -->
<div id="player-action-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-6 w-full max-w-xs text-white shadow-2xl">
    <div class="flex items-center gap-3 mb-4">
      <img id="pa-avatar" src="" alt="" class="w-10 h-10 rounded-full object-cover bg-amber-800" />
      <p id="pa-username" class="font-bold text-base"></p>
    </div>
    <div id="pa-actions" class="flex flex-col gap-2"></div>
    <button id="pa-close-btn" class="mt-3 w-full bg-white/10 hover:bg-white/20 text-white py-2 rounded-xl text-sm transition">{t.common.cancel}</button>
  </div>
</div>

<!-- Edit room modal -->
<div id="edit-room-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-7 w-full max-w-md text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-5">{t.rooms.editRoom}</h3>
    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.roomName}</label>
      <input id="edit-room-name" type="text" maxlength="100"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-400" />
    </div>
    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.maxPlayers}</label>
      <select id="edit-room-max" class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-400">
        {[5,6,7,8,9,10,11,12].map(n => <option value={n}>{n}</option>)}
      </select>
    </div>
    <div class="mb-4">
      <label class="flex items-center gap-2 cursor-pointer">
        <input id="edit-room-private" type="checkbox" class="w-4 h-4 accent-amber-400" />
        <span class="text-sm font-semibold text-white/70"><img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Objects/Locked.png" alt="lock" class="inline-block w-4 h-4" /> {t.rooms.privateRoom}</span>
      </label>
    </div>
    <div id="edit-room-password-field" class="mb-5 hidden">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.password}</label>
      <input id="edit-room-password" type="password" maxlength="50"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-400" />
    </div>
    <div class="flex gap-3">
      <button id="edit-room-save-btn" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.common.save}</button>
      <button id="edit-room-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- Invite bot modal -->
<div id="invite-bot-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-7 w-full max-w-sm text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-4"><img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Smilies/Robot.png" alt="bot" class="inline-block w-5 h-5" /> {t.rooms.myBots}</h3>
    <div id="invite-bot-list" class="flex flex-col gap-2 mb-4 max-h-60 overflow-y-auto">
      <p id="invite-bot-empty" class="text-white/40 text-sm text-center py-4">{t.rooms.noBots}</p>
    </div>
    <button id="invite-bot-cancel" class="w-full bg-white/10 hover:bg-white/20 text-white py-2 rounded-xl text-sm transition">{t.common.cancel}</button>
  </div>
</div>

<script define:vars={{
  apiUrl,
  characterSrc: character.src,
  tHost: t.rooms.host,
  tEmptySlot: t.rooms.emptySlot,
  tStatusWaiting: t.rooms.statusWaiting,
  tStatusPlaying: t.rooms.statusPlaying,
  tSystemJoined: t.rooms.systemJoined,
  tSystemLeft: t.rooms.systemLeft,
  tRoomClosed: t.rooms.roomClosed,
  tSpectate: t.rooms.spectate,
  tUnspectate: t.rooms.unspectate,
  tTransferHost: t.rooms.transferHost,
  tGrantBotInvite: t.rooms.grantBotInvite,
  tRevokeBotInvite: t.rooms.revokeBotInvite,
  tInvite: t.rooms.invite,
  tKick: t.rooms.kick,
  tSystemKicked: t.rooms.systemKicked,
  tDuplicateConnection: t.rooms.duplicateConnection,
  tInvalidPassword: t.rooms.invalidPassword,
}} is:inline>
  const scene = document.getElementById('scene-gameroom');
  const leaveBtn = document.getElementById('leave-room-btn');
  const startBtn = document.getElementById('start-game-btn');
  const editRoomBtn = document.getElementById('edit-room-btn');
  const spectateBtn = document.getElementById('spectate-btn');
  const inviteBotBtn = document.getElementById('invite-bot-btn');
  const nameEl = document.getElementById('gameroom-name');
  const statusBadge = document.getElementById('gameroom-status-badge');
  const privateBadge = document.getElementById('gameroom-private-badge');
  const playerCountEl = document.getElementById('gameroom-player-count');
  const slotsEl = document.getElementById('gameroom-slots');
  const spectatorSection = document.getElementById('gameroom-spectator-section');
  const spectatorSlotsEl = document.getElementById('gameroom-spectator-slots');
  const chatMessages = document.getElementById('chat-messages');
  const chatInput = document.getElementById('chat-input');
  const chatSendBtn = document.getElementById('chat-send-btn');

  // Player action modal
  const paModal = document.getElementById('player-action-modal');
  const paAvatar = document.getElementById('pa-avatar');
  const paUsername = document.getElementById('pa-username');
  const paActions = document.getElementById('pa-actions');
  const paCloseBtn = document.getElementById('pa-close-btn');

  // Edit room modal
  const editModal = document.getElementById('edit-room-modal');
  const editName = document.getElementById('edit-room-name');
  const editMax = document.getElementById('edit-room-max');
  const editPrivate = document.getElementById('edit-room-private');
  const editPasswordField = document.getElementById('edit-room-password-field');
  const editPassword = document.getElementById('edit-room-password');
  const editSaveBtn = document.getElementById('edit-room-save-btn');
  const editCancelBtn = document.getElementById('edit-room-cancel-btn');

  // Invite bot modal
  const inviteBotModal = document.getElementById('invite-bot-modal');
  const inviteBotList = document.getElementById('invite-bot-list');
  const inviteBotEmpty = document.getElementById('invite-bot-empty');
  const inviteBotCancel = document.getElementById('invite-bot-cancel');

  let currentRoom = null;
  let currentUserId = null;
  let currentMembers = [];
  let es = null;

  async function getMyId() {
    if (currentUserId) return currentUserId;
    const token = localStorage.getItem('token');
    if (!token) return null;
    const res = await fetch(`${apiUrl}/api/me`, { headers: { Authorization: `Bearer ${token}` } }).catch(() => null);
    if (!res?.ok) return null;
    const user = await res.json();
    currentUserId = user.id;
    return currentUserId;
  }

  function getToken() { return localStorage.getItem('token'); }

  async function joinAndLoad(room) {
    const token = getToken();
    if (!token) return false;
    const res = await fetch(`${apiUrl}/api/rooms/${room.id}/join`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ password: room.password || '' }),
    }).catch(() => null);
    return res?.ok ?? false;
  }

  function myMember() {
    return currentMembers.find(m => m.userId === currentUserId && !m.botId);
  }

  function isHost() {
    return currentRoom && currentRoom.hostId === currentUserId;
  }

  function canInviteBots() {
    if (isHost()) return true;
    const me = myMember();
    return me?.canInviteBots === true;
  }

  function updateUI(roomState, members) {
    currentRoom = { ...currentRoom, ...roomState };
    currentMembers = members;

    nameEl.textContent = roomState.name;
    const isPlaying = roomState.status === 'playing';
    statusBadge.textContent = isPlaying ? tStatusPlaying : tStatusWaiting;
    statusBadge.className = `text-xs font-semibold px-2 py-0.5 rounded-full ${isPlaying ? 'bg-yellow-500/20 text-yellow-300' : 'bg-green-500/20 text-green-300'}`;
    privateBadge.classList.toggle('hidden', !roomState.isPrivate);

    const players = members.filter(m => !m.isSpectator);
    const spectators = members.filter(m => m.isSpectator);
    playerCountEl.textContent = `${players.length} / ${roomState.maxPlayers}`;

    // Render player slots
    slotsEl.innerHTML = '';
    for (let i = 0; i < roomState.maxPlayers; i++) {
      const member = players[i];
      const slot = document.createElement('div');
      slot.className = 'flex flex-col items-center gap-1';
      if (member) {
        const isBot = !!member.botId;
        const isMemberHost = member.userId === roomState.hostId && !isBot;
        const isMine = member.userId === currentUserId;
        const isClickable = (isHost() && !isMine) || (isBot && isMine);
        slot.className += isClickable ? ' cursor-pointer hover:opacity-80 transition' : '';
        slot.innerHTML = `
          <div class="relative">
            <img src="${member.avatarUrl || characterSrc}" alt="${member.username}"
              class="w-10 h-10 rounded-full object-cover bg-amber-800 border-2 ${isMemberHost ? 'border-amber-400' : 'border-white/20'}"
              onerror="this.src='${characterSrc}'" />
            ${isBot ? `<span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-gray-900 ${member.isOnline ? 'bg-green-500' : 'bg-gray-500'}"></span>` : ''}
          </div>
          <p class="text-white/70 text-xs truncate w-full text-center max-w-[64px]">${isMemberHost ? '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Glowing%20Star.png" alt="star" class="inline-block w-3 h-3" /> ' : ''}${member.username}</p>
          ${isBot && member.ownerUsername ? `<p class="text-white/30 text-xs truncate w-full text-center max-w-[64px]">${member.ownerUsername}</p>` : ''}
          ${member.canInviteBots && !isBot ? '<p class="text-blue-300 text-xs">🔑</p>' : ''}
        `;
        if (isClickable) {
          slot.addEventListener('click', () => openPlayerAction(member));
        }
      } else {
        slot.innerHTML = `
          <div class="w-10 h-10 rounded-full bg-white/5 border border-dashed border-white/10 flex items-center justify-center">
            <span class="text-white/20 text-sm">+</span>
          </div>
          <p class="text-white/20 text-xs">${tEmptySlot}</p>
        `;
      }
      slotsEl.appendChild(slot);
    }

    // Spectators
    if (spectators.length > 0) {
      spectatorSection.classList.remove('hidden');
      spectatorSlotsEl.innerHTML = '';
      spectators.forEach(s => {
        const el = document.createElement('div');
        el.className = 'flex items-center gap-1.5 bg-white/5 rounded-lg px-2 py-1';
        el.innerHTML = `
          <img src="${s.avatarUrl || characterSrc}" alt="${s.username}"
            class="w-5 h-5 rounded-full object-cover bg-amber-800"
            onerror="this.src='${characterSrc}'" />
          <span class="text-white/50 text-xs">${s.userId === roomState.hostId ? '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Travel%20and%20places/Glowing%20Star.png" alt="star" class="inline-block w-3 h-3" /> ' : ''}${s.username}</span>
        `;
        spectatorSlotsEl.appendChild(el);
      });
    } else {
      spectatorSection.classList.add('hidden');
    }

    // My member state
    const me = myMember();
    if (me?.isSpectator) {
      spectateBtn.textContent = tUnspectate;
    } else {
      spectateBtn.textContent = tSpectate;
    }

    // Host-only UI
    editRoomBtn.classList.toggle('hidden', !isHost());
    startBtn.classList.toggle('hidden', !isHost());
    const nonSpectatorCount = members.filter(m => !m.isSpectator).length;
    startBtn.disabled = nonSpectatorCount < 5;
    startBtn.className = startBtn.className.replace(/ opacity-40 cursor-not-allowed| cursor-not-allowed| opacity-40/g, '');
    if (nonSpectatorCount < 5) startBtn.classList.add('opacity-40', 'cursor-not-allowed');
    inviteBotBtn.classList.toggle('hidden', !canInviteBots());
  }

  function openPlayerAction(member) {
    paAvatar.src = member.avatarUrl || characterSrc;
    paUsername.textContent = member.username;
    paActions.innerHTML = '';

    const addBtn = (label, onClick) => {
      const btn = document.createElement('button');
      btn.className = 'w-full bg-white/10 hover:bg-white/20 text-white py-2 rounded-xl text-sm transition text-left px-3';
      btn.textContent = label;
      btn.addEventListener('click', () => { closeModal(paModal); onClick(); });
      paActions.appendChild(btn);
    };

    if (isHost()) {
      if (!member.botId) {
        addBtn(tTransferHost, () => doTransferHost(member.userId));
        if (member.canInviteBots) {
          addBtn(tRevokeBotInvite, () => doSetPermission(member.userId, false));
        } else {
          addBtn(tGrantBotInvite, () => doSetPermission(member.userId, true));
        }
      }
      addBtn(`🚫 ${tKick}`, () => doKick(member));
    } else if (member.botId && member.userId === currentUserId) {
      // Bot owner can kick their own bot even if not host
      addBtn(`🚫 ${tKick}`, () => doKick(member));
    }

    openModal(paModal);
  }

  async function doKick(member) {
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/kick`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify(member.botId ? { botId: member.botId } : { targetUserId: member.userId }),
    }).catch(() => null);
  }

  async function doTransferHost(targetUserId) {
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/transfer-host`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ targetUserId }),
    }).catch(() => null);
  }

  async function doSetPermission(targetUserId, canInviteBots) {
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/members/${targetUserId}/permissions`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ canInviteBots }),
    }).catch(() => null);
  }

  // Spectate
  spectateBtn.addEventListener('click', async () => {
    const me = myMember();
    const token = getToken();
    const spectate = me ? !me.isSpectator : false;
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/spectate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ spectate }),
    }).catch(() => null);
  });

  // Edit room
  editRoomBtn.addEventListener('click', () => {
    editName.value = currentRoom.name || '';
    editMax.value = String(currentRoom.maxPlayers || 8);
    editPrivate.checked = !!currentRoom.isPrivate;
    editPasswordField.classList.toggle('hidden', !currentRoom.isPrivate);
    editPassword.value = '';
    openModal(editModal);
  });
  editPrivate.addEventListener('change', () => {
    editPasswordField.classList.toggle('hidden', !editPrivate.checked);
  });
  editSaveBtn.addEventListener('click', async () => {
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({
        name: editName.value.trim() || currentRoom.name,
        maxPlayers: parseInt(editMax.value),
        isPrivate: editPrivate.checked,
        password: editPassword.value,
      }),
    }).catch(() => null);
    closeModal(editModal);
  });
  editCancelBtn.addEventListener('click', () => closeModal(editModal));

  // Invite bot
  inviteBotBtn.addEventListener('click', async () => {
    inviteBotList.innerHTML = '';
    inviteBotList.appendChild(inviteBotEmpty);
    const token = getToken();
    const res = await fetch(`${apiUrl}/api/bots`, { headers: { Authorization: `Bearer ${token}` } }).catch(() => null);
    if (res?.ok) {
      const bots = await res.json();
      if (bots && bots.length > 0) {
        inviteBotEmpty.classList.add('hidden');
        bots.forEach(bot => {
          const el = document.createElement('div');
          el.className = 'flex items-center gap-3 bg-white/5 hover:bg-white/10 rounded-xl px-3 py-2 cursor-pointer transition';
          el.innerHTML = `
            <img src="${bot.avatarUrl || characterSrc}" alt="${bot.name}"
              class="w-8 h-8 rounded-full object-cover bg-amber-800"
              onerror="this.src='${characterSrc}'" />
            <span class="text-white text-sm font-semibold flex-1">${bot.name}</span>
            <button class="bg-blue-500 hover:bg-blue-400 text-white text-xs px-3 py-1 rounded-lg">${tInvite}</button>
          `;
          el.querySelector('button').addEventListener('click', async () => {
            const r = await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/invite-bot`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
              body: JSON.stringify({ botId: bot.id }),
            }).catch(() => null);
            if (r?.ok) closeModal(inviteBotModal);
          });
          inviteBotList.appendChild(el);
        });
      } else {
        inviteBotEmpty.classList.remove('hidden');
      }
    }
    openModal(inviteBotModal);
  });
  inviteBotCancel.addEventListener('click', () => closeModal(inviteBotModal));
  paCloseBtn.addEventListener('click', () => closeModal(paModal));

  function openModal(el) {
    el.classList.remove('hidden');
    el.classList.add('flex');
  }
  function closeModal(el) {
    el.classList.add('hidden');
    el.classList.remove('flex');
  }

  // Chat
  function appendChatMessage(msg) {
    const isMine = msg.userId === currentUserId;
    const el = document.createElement('div');
    el.className = `flex items-end gap-2 ${isMine ? 'flex-row-reverse' : ''}`;
    el.innerHTML = `
      <img src="${msg.avatarUrl || characterSrc}" alt="${msg.username}"
        class="w-7 h-7 rounded-full object-cover flex-shrink-0 bg-amber-800"
        onerror="this.src='${characterSrc}'" />
      <div class="max-w-[70%]">
        ${!isMine ? `<p class="text-white/60 text-xs mb-0.5 px-1">${msg.username}</p>` : ''}
        <div class="px-3 py-2 rounded-2xl text-sm ${isMine ? 'bg-amber-500 text-gray-900 rounded-br-sm' : 'bg-gray-800 text-white rounded-bl-sm'}">
          ${msg.message}
        </div>
        ${isMine ? `<p class="text-white/40 text-xs mt-0.5 ${isMine ? 'text-right' : ''} px-1">${msg.username}</p>` : ''}
      </div>
    `;
    chatMessages.appendChild(el);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function appendSystemMessage(text) {
    const el = document.createElement('p');
    el.className = 'text-center text-white/30 text-xs my-1';
    el.textContent = text;
    chatMessages.appendChild(el);
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  function connectSSE(room) {
    const token = getToken();
    if (!token) return;
    es = new EventSource(`${apiUrl}/api/rooms/${room.id}/sse?token=${token}`);

    es.addEventListener('open', () => {
      document.dispatchEvent(new CustomEvent('room:sse', { detail: 'connected' }));
    });

    es.addEventListener('message', (e) => {
      try {
        const msg = JSON.parse(e.data);
        if (msg.type === 'chat') {
          appendChatMessage(msg);
        } else if (msg.type === 'join') {
          appendSystemMessage(`${msg.username} ${tSystemJoined}`);
        } else if (msg.type === 'leave') {
          appendSystemMessage(`${msg.username} ${tSystemLeft}`);
        } else if (msg.type === 'duplicate') {
          es.close(); es = null; // prevent auto-reconnect
          appendSystemMessage(tDuplicateConnection);
          currentRoom = null; // prevent POST /leave from closing the new connection
          setTimeout(() => leaveRoom(), 2000);
        } else if (msg.type === 'kicked') {
          appendSystemMessage(tSystemKicked);
          setTimeout(() => leaveRoom(), 1500);
        } else if (msg.type === 'game_start') {
          document.dispatchEvent(new CustomEvent('room:sse:game_start', { detail: msg }));
        } else if (msg.type === 'game_action' || msg.type === 'game_chat' || msg.type === 'game_end' || msg.type === 'turn_start' || msg.type === 'timer_sync' || msg.type === 'draw' || msg.type === 'overflow_discard' || msg.type === 'death' || msg.type === 'kill_reward' || msg.type === 'friendly_fire_jail' || msg.type === 'end_turn' || msg.type === 'timeout') {
          document.dispatchEvent(new CustomEvent('room:sse:game', { detail: msg }));
        } else if (msg.type === 'room_update') {
          updateUI(msg, msg.members || []);
        } else if (msg.type === 'room_closed') {
          appendSystemMessage(tRoomClosed);
          setTimeout(() => leaveRoom(), 1500);
        }
      } catch {}
    });

    es.addEventListener('error', () => {
      // EventSource auto-reconnects; close only if we intentionally left
      document.dispatchEvent(new CustomEvent('room:sse', { detail: 'reconnecting' }));
    });
  }

  async function sendChat() {
    const msg = chatInput.value.trim();
    if (!msg) return;
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ message: msg }),
    }).catch(() => null);
    chatInput.value = '';
  }

  async function leaveRoom() {
    if (currentRoom) {
      const token = getToken();
      await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/leave`, {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
      }).catch(() => null);
    }
    if (es) { es.close(); es = null; }
    document.dispatchEvent(new CustomEvent('room:sse', { detail: 'disconnected' }));
    currentRoom = null;
    currentMembers = [];
    chatMessages.innerHTML = '';
    closeModal(paModal);
    closeModal(editModal);
    closeModal(inviteBotModal);
    scene.classList.add('hidden');
    scene.classList.remove('flex');
    document.dispatchEvent(new CustomEvent('game:scene', { detail: 'rooms' }));
  }

  document.addEventListener('room:join', async (e) => {
    const room = e.detail;
    if (!room) return;
    if (es) { es.close(); es = null; }
    chatMessages.innerHTML = '';
    currentRoom = room;
    currentMembers = [];

    // Set initial UI from room data
    nameEl.textContent = room.name;
    playerCountEl.textContent = `${room.playerCount} / ${room.maxPlayers}`;

    scene.classList.remove('hidden');
    scene.classList.add('flex');
    document.dispatchEvent(new CustomEvent('game:scene', { detail: 'gameroom' }));

    await getMyId();
    const joined = await joinAndLoad(room);
    if (!joined) {
      currentRoom = null;
      scene.classList.add('hidden');
      scene.classList.remove('flex');
      document.dispatchEvent(new CustomEvent('game:scene', { detail: 'rooms' }));
      document.dispatchEvent(new CustomEvent('room:join:error', { detail: { room, hadPassword: !!room.password } }));
      return;
    }
    connectSSE(room);
  });

  document.addEventListener('game:scene', (e) => {
    if (e.detail !== 'gameroom') {
      // Keep SSE alive during gameplay (game uses the same room SSE channel)
      if (e.detail !== 'gameplay') {
        if (currentRoom) {
          const token = getToken();
          const roomId = currentRoom.id;
          navigator.sendBeacon(`${apiUrl}/api/rooms/${roomId}/leave?token=${token}`);
          currentRoom = null;
          currentMembers = [];
          chatMessages.innerHTML = '';
          closeModal(paModal);
          closeModal(editModal);
          closeModal(inviteBotModal);
        }
        if (es) { es.close(); es = null; }
        document.dispatchEvent(new CustomEvent('room:sse', { detail: 'disconnected' }));
      }
      scene.classList.add('hidden');
      scene.classList.remove('flex');
    }
  });

  document.addEventListener('game:session:replaced', () => {
    currentRoom = null;
  });

  window.addEventListener('beforeunload', () => {
    // Don't send leave during active gameplay (game handles its own lifecycle)
    const gameplayScene = document.getElementById('scene-gameplay');
    const isInGame = gameplayScene && gameplayScene.classList.contains('flex');
    if (currentRoom && !isInGame) {
      const token = getToken();
      navigator.sendBeacon(`${apiUrl}/api/rooms/${currentRoom.id}/leave?token=${token}`);
    }
  });

  startBtn.addEventListener('click', async () => {
    if (!currentRoom) return;
    const token = getToken();
    await fetch(`${apiUrl}/api/rooms/${currentRoom.id}/start`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
  });

  leaveBtn.addEventListener('click', leaveRoom);
  chatSendBtn.addEventListener('click', sendChat);
  chatInput.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing) sendChat(); });
</script>
