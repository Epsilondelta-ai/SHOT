---
import { Image } from 'astro:assets';
import logo from '../assets/logo.webp';
import character from '../assets/character.webp';
import headerBg from '../assets/header.webp';
import { locales, localeLabels, type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';

interface Props {
  lang: Locale;
  path?: string;
}

const { lang, path = '/game' } = Astro.props;
const t = useTranslations(lang);

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
---

<header class="sticky top-0 z-40 shadow-xl border-b-4 border-black/60" style={`background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)), url(${headerBg.src}); background-size: cover; background-position: center;`}>
  <div class="max-w-3xl mx-auto px-5 py-3 flex items-center gap-4">
    <button id="nav-rooms" class="cursor-pointer">
      <Image src={logo} alt="SHOT!" height={52} class="object-contain" />
    </button>

    <!-- Desktop nav -->
    <nav class="hidden sm:flex items-center gap-5 text-amber-100 font-semibold text-sm">
      <button id="nav-lobby" class="nav-item hover:text-white transition cursor-pointer px-5 py-2 rounded-lg" data-scene="rooms">{t.game.lobby}</button>
      <button id="nav-bots" class="nav-item hover:text-white transition cursor-pointer px-5 py-2 rounded-lg" data-scene="bots">{t.game.bots}</button>
      <button id="nav-mypage" class="nav-item flex items-center gap-2 hover:text-white transition cursor-pointer px-5 py-2 rounded-lg" data-scene="mypage">
        <img
          id="header-avatar"
          src={character.src}
          alt="프로필"
          class="w-7 h-7 rounded-full object-cover bg-amber-300"
        />
        {t.game.mypage}
      </button>
    </nav>

    <!-- Desktop right area -->
    <div class="hidden sm:flex ml-auto items-center gap-2">
      <span id="sse-dot-desktop" class="hidden w-2.5 h-2.5 rounded-full"></span>
      <!-- Desktop language selector -->
      <div class="relative" id="lang-menu-wrapper">
      <button
        id="lang-menu-btn"
        class="flex items-center gap-1 text-amber-100 hover:text-white transition font-semibold text-md px-2 py-2 rounded-lg hover:bg-black/20"
        aria-label="Select language"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
        </svg>
        <span class="text-sm font-semibold">{localeLabels[lang]}</span>
      </button>
      <ul
        id="lang-menu"
        class="hidden absolute right-0 top-full mt-1 bg-white rounded-xl shadow-xl border border-gray-100 py-1 z-50 min-w-max"
      >
        {locales.map(l => (
          <li>
            <a
              href={`/${l}${path}`}
              class={`block px-4 py-2 text-sm hover:bg-amber-50 transition ${l === lang ? 'text-amber-600 font-bold' : 'text-gray-700'}`}
            >
              {localeLabels[l]}
            </a>
          </li>
        ))}
      </ul>
      </div>
    </div>

    <!-- Mobile hamburger -->
    <div class="sm:hidden ml-auto flex items-center gap-2 relative" id="hamburger-wrapper">
      <span id="sse-dot-mobile" class="hidden w-2.5 h-2.5 rounded-full"></span>
      <button
        id="hamburger-btn"
        class="flex flex-col justify-center items-center w-10 h-10 gap-1.5 text-amber-100 hover:text-white rounded-lg hover:bg-black/20 transition"
        aria-label="Open menu"
      >
        <span class="block w-5 h-0.5 bg-current"></span>
        <span class="block w-5 h-0.5 bg-current"></span>
        <span class="block w-5 h-0.5 bg-current"></span>
      </button>
      <div
        id="hamburger-menu"
        class="hidden absolute right-0 top-full mt-1 bg-white rounded-xl shadow-xl border border-gray-100 py-2 z-50 min-w-[160px]"
      >
        <button id="mobile-nav-lobby" class="mobile-nav-item w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-amber-50 transition font-semibold" data-scene="rooms">{t.game.lobby}</button>
        <button id="mobile-nav-bots" class="mobile-nav-item w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-amber-50 transition font-semibold" data-scene="bots">{t.game.bots}</button>
        <button id="mobile-nav-mypage" class="mobile-nav-item w-full text-left flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-amber-50 transition font-semibold" data-scene="mypage">
          <img
            id="mobile-header-avatar"
            src={character.src}
            alt="프로필"
            class="w-6 h-6 rounded-full object-cover bg-amber-200"
          />
          {t.game.mypage}
        </button>
        <hr id="mobile-lang-divider" class="my-1 border-gray-100" />
        <div id="mobile-lang-wrapper" class="px-4 py-2">
          <select
            id="mobile-lang-select"
            class="w-full text-sm text-gray-700 border border-gray-200 rounded-lg px-2 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400"
          >
            {locales.map(l => (
              <option value={`/${l}${path}`} selected={l === lang}>
                {localeLabels[l]}
              </option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ apiUrl }} is:inline>
  const token = localStorage.getItem('token');
  if (token) {
    fetch(`${apiUrl}/api/me`, {
      headers: { Authorization: `Bearer ${token}` },
    })
      .then(res => res.ok ? res.json() : null)
      .then(user => {
        if (!user || !user.avatarUrl) return;
        document.getElementById('header-avatar')?.setAttribute('src', user.avatarUrl);
        document.getElementById('mobile-header-avatar')?.setAttribute('src', user.avatarUrl);
      })
      .catch(() => {});
  }
</script>

<script>
  // Desktop language menu
  const btn = document.getElementById('lang-menu-btn');
  const menu = document.getElementById('lang-menu');
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
  });

  // Mobile hamburger menu
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const hamburgerMenu = document.getElementById('hamburger-menu');
  hamburgerBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    hamburgerMenu?.classList.toggle('hidden');
  });

  // Mobile language select
  const mobileLangSelect = document.getElementById('mobile-lang-select') as HTMLSelectElement | null;
  mobileLangSelect?.addEventListener('change', () => {
    window.location.href = mobileLangSelect.value;
  });

  // Close both menus on outside click
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (!document.getElementById('lang-menu-wrapper')?.contains(target)) {
      menu?.classList.add('hidden');
    }
    if (!document.getElementById('hamburger-wrapper')?.contains(target)) {
      hamburgerMenu?.classList.add('hidden');
    }
  });

  // SSE connection indicator
  const sseDots = [
    document.getElementById('sse-dot-desktop'),
    document.getElementById('sse-dot-mobile'),
  ];

  document.addEventListener('room:sse', (e: Event) => {
    const status = (e as CustomEvent).detail as string;
    sseDots.forEach(dot => {
      if (!dot) return;
      if (status === 'connected') {
        dot.className = 'block w-2.5 h-2.5 rounded-full bg-green-400';
      } else if (status === 'reconnecting') {
        dot.className = 'block w-2.5 h-2.5 rounded-full bg-yellow-400 animate-pulse';
      } else {
        dot.className = 'hidden w-2.5 h-2.5 rounded-full';
      }
    });
  });

  // Hide language selector in gameroom
  const langMenuWrapper = document.getElementById('lang-menu-wrapper');
  const mobileLangDivider = document.getElementById('mobile-lang-divider');
  const mobileLangWrapperEl = document.getElementById('mobile-lang-wrapper');

  document.addEventListener('game:scene', (e: Event) => {
    const scene = (e as CustomEvent).detail as string;
    const inRoom = scene === 'gameroom';
    if (langMenuWrapper) langMenuWrapper.style.display = inRoom ? 'none' : '';
    if (mobileLangDivider) mobileLangDivider.style.display = inRoom ? 'none' : '';
    if (mobileLangWrapperEl) mobileLangWrapperEl.style.display = inRoom ? 'none' : '';
  });

  // Active nav highlight
  function setActiveNav(scene: string) {
    document.querySelectorAll<HTMLElement>('.nav-item').forEach(el => {
      const isActive = el.dataset.scene === scene;
      el.classList.toggle('text-white', isActive);
      el.classList.toggle('bg-black/30', isActive);
      el.classList.toggle('shadow-inner', isActive);
      el.classList.toggle('border', isActive);
      el.classList.toggle('border-amber-300/20', isActive);
      el.classList.toggle('text-amber-100', !isActive);
    });
    document.querySelectorAll<HTMLElement>('.mobile-nav-item').forEach(el => {
      const isActive = el.dataset.scene === scene;
      el.classList.toggle('text-amber-600', isActive);
      el.classList.toggle('bg-amber-50', isActive);
      el.classList.toggle('text-gray-700', !isActive);
    });
  }

  document.addEventListener('game:scene', (e: Event) => {
    const scene = (e as CustomEvent).detail as string;
    setActiveNav(scene === 'gameroom' ? 'rooms' : scene);
  });

  // Scene change events
  ['nav-rooms', 'nav-lobby'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('game:scene', { detail: 'rooms' }));
    });
  });
  ['nav-bots', 'mobile-nav-bots'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('game:scene', { detail: 'bots' }));
      hamburgerMenu?.classList.add('hidden');
    });
  });
  ['nav-mypage', 'mobile-nav-mypage'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('game:scene', { detail: 'mypage' }));
      hamburgerMenu?.classList.add('hidden');
    });
  });
  ['mobile-nav-lobby'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('game:scene', { detail: 'rooms' }));
      hamburgerMenu?.classList.add('hidden');
    });
  });

  // Set initial active state
  setActiveNav('rooms');
</script>
