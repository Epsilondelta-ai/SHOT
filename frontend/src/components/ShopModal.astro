---
import { type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const tierColors: Record<string, string> = {
  Free: 'bg-gray-100 text-gray-600',
  Basic: 'bg-green-100 text-green-700',
  Standard: 'bg-blue-100 text-blue-700',
  Advanced: 'bg-purple-100 text-purple-700',
  Premium: 'bg-amber-100 text-amber-700',
};
---

<!-- Backdrop -->
<div id="shop-modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
  <!-- Modal box -->
  <div class="bg-gray-950 border border-gray-700 rounded-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto shadow-2xl">

    <!-- Header row: title + credit balance + close button -->
    <div class="sticky top-0 bg-gray-950 border-b border-gray-800 px-6 py-4 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <h2 class="text-xl font-bold text-white">{t.shop.title}</h2>
        <!-- credit balance shown when logged in -->
        <div id="modal-credit-balance" class="hidden bg-gray-800 rounded-xl px-4 py-1.5 text-right">
          <span class="text-xs text-gray-400">{t.shop.myCredits}: </span>
          <span id="modal-credit-amount" class="text-amber-400 font-bold">-</span>
        </div>
      </div>
      <button id="shop-modal-close" class="text-gray-400 hover:text-white transition p-1" aria-label="Close">
        <!-- X icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="px-6 py-6 space-y-8">

      <!-- Error / Info Banner -->
      <div id="modal-shop-banner" class="hidden px-4 py-3 rounded-xl text-sm font-medium"></div>

      <!-- Credit Packs -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">{t.shop.creditPacks}</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {t.shop.packs.map((pack, i) => {
            const isMostPopular = 'badge' in pack && pack.badge === 'mostPopular';
            const isBestValue = 'badge' in pack && pack.badge === 'bestValue';
            const borderClass = isMostPopular
              ? 'border-amber-400 ring-2 ring-amber-400/30'
              : isBestValue
                ? 'border-yellow-500 ring-2 ring-yellow-500/30'
                : 'border-gray-700';
            return (
              <div class={`relative bg-gray-900 rounded-2xl p-5 border-2 ${borderClass}`}>
                {isMostPopular && (
                  <span class="absolute -top-3 left-4 bg-amber-400 text-black text-xs font-bold px-3 py-1 rounded-full">
                    {t.shop.mostPopular}
                  </span>
                )}
                {isBestValue && (
                  <span class="absolute -top-3 left-4 bg-yellow-500 text-black text-xs font-bold px-3 py-1 rounded-full">
                    {t.shop.bestValue}
                  </span>
                )}
                <p class="text-base font-bold text-white mb-1">{pack.name}</p>
                <p class="text-2xl font-extrabold text-amber-400 mb-0.5">
                  {pack.credits.toLocaleString()} <span class="text-xs font-normal text-gray-400">{t.shop.credits}</span>
                </p>
                <p class="text-gray-400 text-sm mb-3">{pack.price}</p>
                <button
                  class="modal-buy-btn w-full py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-semibold text-sm transition disabled:bg-gray-700 disabled:text-gray-500 disabled:cursor-not-allowed"
                  data-pack-index={i}
                  data-buy-label={t.shop.buyNow}
                  data-loading-label={t.shop.processing}
                  data-login-label={t.shop.loginToBuy}
                  data-coming-soon-label={t.shop.comingSoon}
                  disabled
                >
                  {t.shop.buyNow}
                </button>
              </div>
            );
          })}
        </div>
      </div>

      <!-- How Credits Work -->
      <div class="bg-gray-900 rounded-2xl p-5 border border-gray-800">
        <p class="text-sm font-semibold text-white mb-1">{t.shop.howItWorks}</p>
        <p class="text-gray-400 text-sm">{t.shop.howDesc}</p>
      </div>

      <!-- Model Pricing -->
      <div>
        <h3 class="text-lg font-bold text-white mb-4">{t.shop.modelPricing}</h3>
        <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-800">
                <th class="text-left text-gray-400 font-semibold px-4 py-3">Model</th>
                <th class="text-center text-gray-400 font-semibold px-4 py-3">{t.shop.credits}</th>
                <th class="text-center text-gray-400 font-semibold px-4 py-3">Tier</th>
              </tr>
            </thead>
            <tbody>
              {t.shop.models.map(model => (
                <tr class="border-b border-gray-800/50 last:border-0">
                  <td class="text-white px-4 py-3">{model.name}</td>
                  <td class="text-center text-amber-400 font-semibold px-4 py-3">{model.cost === 0 ? '\u2014' : model.cost}</td>
                  <td class="text-center px-4 py-3">
                    <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${tierColors[model.tier] ?? 'bg-gray-100 text-gray-600'}`}>
                      {model.tier}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const apiUrl = (import.meta.env.PUBLIC_API_URL as string) ?? 'http://localhost:3000';
  const lang = window.location.pathname.split('/')[1] || 'ko';

  let packIds: string[] = [];
  let initialized = false;

  const backdrop = document.getElementById('shop-modal-backdrop')!;
  const closeBtn = document.getElementById('shop-modal-close')!;

  function openModal() {
    backdrop.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    if (!initialized) initModal();
  }

  function closeModal() {
    backdrop.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Open via data-shop-trigger attribute
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-shop-trigger]')) openModal();
  });

  // Open via custom event (e.g., from bot invite failure)
  window.addEventListener('open-shop-modal', () => openModal());

  // Close
  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) closeModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  function showBanner(msg: string, type: 'error' | 'info') {
    const el = document.getElementById('modal-shop-banner')!;
    el.textContent = msg;
    el.className = type === 'error'
      ? 'px-4 py-3 rounded-xl text-sm font-medium bg-red-900/50 border border-red-700 text-red-300'
      : 'px-4 py-3 rounded-xl text-sm font-medium bg-blue-900/50 border border-blue-700 text-blue-300';
  }

  async function initModal() {
    initialized = true;
    const token = localStorage.getItem('token');
    const buttons = document.querySelectorAll<HTMLButtonElement>('.modal-buy-btn');

    // Fetch pack IDs
    try {
      const res = await fetch(`${apiUrl}/api/shop/packs`);
      if (res.ok) {
        const packs: { id: string; credits: number }[] = await res.json();
        packs.sort((a, b) => a.credits - b.credits);
        packIds = packs.map(p => p.id);
      }
    } catch { /* ignore */ }

    // Fetch credit balance
    if (token) {
      try {
        const res = await fetch(`${apiUrl}/api/credits`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.ok) {
          const data: { credits: number } = await res.json();
          document.getElementById('modal-credit-amount')!.textContent = data.credits.toLocaleString();
          document.getElementById('modal-credit-balance')!.classList.remove('hidden');
        }
      } catch { /* ignore */ }
    }

    // Configure buy buttons
    if (import.meta.env.PROD) {
      buttons.forEach(btn => {
        btn.textContent = btn.dataset.comingSoonLabel!;
        btn.disabled = true;
      });
      return;
    }

    buttons.forEach(btn => {
      const idx = Number(btn.dataset.packIndex);
      const packId = packIds[idx];

      if (!token) {
        btn.textContent = btn.dataset.loginLabel!;
        btn.disabled = false;
        btn.addEventListener('click', () => { window.location.href = `/${lang}/login`; });
        return;
      }

      if (!packId) {
        btn.textContent = btn.dataset.comingSoonLabel!;
        btn.disabled = true;
        return;
      }

      btn.disabled = false;
      btn.textContent = btn.dataset.buyLabel!;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = btn.dataset.loadingLabel!;
        try {
          const res = await fetch(`${apiUrl}/api/shop/checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
            body: JSON.stringify({ pack_id: packId }),
          });
          if (res.status === 503) { btn.textContent = btn.dataset.comingSoonLabel!; btn.disabled = true; return; }
          if (res.status === 401) { window.location.href = `/${lang}/login`; return; }
          if (!res.ok) {
            const err: { error?: string } = await res.json().catch(() => ({}));
            showBanner(err.error ?? 'An error occurred.', 'error');
            btn.disabled = false; btn.textContent = btn.dataset.buyLabel!;
            return;
          }
          const data: { checkout_url: string } = await res.json();
          window.location.href = data.checkout_url;
        } catch {
          showBanner('Network error. Please try again.', 'error');
          btn.disabled = false; btn.textContent = btn.dataset.buyLabel!;
        }
      });
    });
  }
</script>
