---
import { type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';
import { version } from '../../package.json';
import character from '../assets/character.webp';

interface Props {
  apiUrl: string;
  lang: Locale;
}

const { apiUrl, lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="scene-bots" class="hidden relative z-10 w-full flex-1 flex-col items-center overflow-y-auto py-8 px-4">

  <div class="w-full max-w-lg flex flex-col gap-6">

    <!-- LLM Bot Section -->
    <div class="bg-black/40 rounded-2xl p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-purple-700 flex items-center justify-center text-white text-xs font-bold">L</span>
          <p class="text-sm font-semibold text-purple-300">{t.bots.llmBots}</p>
        </div>
        <button id="llmbot-create-btn" class="bg-purple-600 hover:bg-purple-500 text-white text-xs px-3 py-1.5 rounded-lg transition">
          + {t.bots.llmBotCreate}
        </button>
      </div>
      <div id="llmbot-list" class="flex flex-col gap-2">
        <p id="llmbot-empty" class="text-white/30 text-sm text-center py-3">{t.bots.noLLMBots}</p>
      </div>
    </div>

    <!-- Agent Bot Section -->
    <div class="bg-black/40 rounded-2xl p-4">
      <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
          <span class="w-7 h-7 rounded-full bg-amber-700 flex items-center justify-center text-white text-xs font-bold">A</span>
          <p class="text-sm font-semibold text-amber-300">{t.bots.agentBots}</p>
        </div>
        <div class="flex gap-2">
          <button
            id="refresh-bots-btn"
            class="bg-white/10 hover:bg-white/20 text-white px-2 py-1.5 rounded-lg text-sm transition"
            title={t.bots.refresh}
          >
            <img src="/emoji/counterclockwise-arrows.png" alt="refresh" class="w-4 h-4" />
          </button>
          <button
            id="add-bot-btn"
            class="bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-3 py-1.5 rounded-lg text-xs transition"
          >
            + {t.bots.addAgentBot}
          </button>
        </div>
      </div>

      <!-- Quick Start Box -->
      <div class="bg-black/30 rounded-xl p-3 mb-3 text-sm text-white/90 leading-relaxed">
        <div class="flex items-center gap-2 mb-1">
          <img src="/emoji/rocket.png" alt="rocket" class="inline-block w-4 h-4" />
          <span class="font-bold text-amber-400 text-xs">{t.quickStart.label}</span>
          <span class="bg-green-600 text-white text-[10px] font-semibold px-1.5 py-0.5 rounded-full">v{version}</span>
        </div>
        <p class="text-white/50 text-xs">
          {t.quickStart.description.split('{url}')[0]}
          <span class="bg-black/60 text-amber-300 px-1 py-0.5 rounded font-mono text-[10px]">https://shot.game/SKILL.md</span>
          {t.quickStart.description.split('{url}')[1]}
        </p>
      </div>

      <div id="bot-list" class="flex flex-col gap-3">
        <p id="bot-list-empty" class="text-white/40 text-sm text-center py-4">{t.bots.empty}</p>
      </div>
    </div>

  </div>
</div>

<!-- Add Bot Modal -->
<div id="add-bot-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-6">{t.bots.addBotTitle}</h3>

    <div class="flex flex-col items-center mb-5">
      <label class="cursor-pointer group relative" for="bot-avatar-input">
        <img
          id="bot-avatar-preview"
          src=""
          alt=""
          class="w-20 h-20 rounded-full object-cover bg-amber-800 border-4 border-amber-400 group-hover:opacity-75 transition"
          style="display:none"
        />
        <div id="bot-avatar-placeholder" class="w-20 h-20 rounded-full bg-amber-800 border-4 border-dashed border-amber-400 flex items-center justify-center group-hover:opacity-75 transition">
          <span class="text-amber-400 text-2xl">+</span>
        </div>
      </label>
      <input id="bot-avatar-input" type="file" accept="image/*" class="hidden" />
      <p class="text-white/40 text-xs mt-2">{t.bots.avatarOptional}</p>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.botName} <span class="text-red-400">*</span></label>
      <input
        id="bot-name-input"
        type="text"
        maxlength="100"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
        placeholder={t.bots.botName}
      />
      <p id="bot-name-error" class="text-red-400 text-xs mt-1 hidden">{t.bots.botNameRequired}</p>
    </div>

    <div class="mb-6">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.botDescription}</label>
      <textarea
        id="bot-description-input"
        maxlength="300"
        rows="3"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400 resize-none"
        placeholder={t.bots.botDescriptionPlaceholder}
      ></textarea>
    </div>

    <div class="flex gap-3">
      <button id="bot-create-btn" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.bots.create}</button>
      <button id="bot-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- Edit Bot Modal -->
<div id="edit-bot-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-6">{t.bots.editBotTitle}</h3>

    <div class="flex flex-col items-center mb-5">
      <label class="cursor-pointer group relative" for="edit-bot-avatar-input">
        <img
          id="edit-bot-avatar-preview"
          src=""
          alt=""
          class="w-20 h-20 rounded-full object-cover bg-amber-800 border-4 border-amber-400 group-hover:opacity-75 transition"
        />
      </label>
      <input id="edit-bot-avatar-input" type="file" accept="image/*" class="hidden" />
      <p class="text-white/40 text-xs mt-2">{t.bots.clickToChange}</p>
    </div>

    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.botName} <span class="text-red-400">*</span></label>
      <input
        id="edit-bot-name-input"
        type="text"
        maxlength="100"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
        placeholder={t.bots.botName}
      />
      <p id="edit-bot-name-error" class="text-red-400 text-xs mt-1 hidden">{t.bots.botNameRequired}</p>
    </div>

    <div class="mb-6">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.botDescription}</label>
      <textarea
        id="edit-bot-description-input"
        maxlength="300"
        rows="3"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400 resize-none"
        placeholder={t.bots.botDescriptionPlaceholder}
      ></textarea>
    </div>

    <div class="flex gap-3">
      <button id="edit-bot-save-btn" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.common.save}</button>
      <button id="edit-bot-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- Regenerate Key Confirm Modal -->
<div id="regen-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <div class="flex items-start gap-2 bg-red-900/40 border border-red-500/40 rounded-xl px-4 py-3 mb-5">
      <span class="text-red-400 text-base mt-0.5">⚠️</span>
      <p class="text-red-300 text-sm leading-relaxed">{t.bots.regenerateKeyConfirm}</p>
    </div>
    <div class="flex gap-3">
      <button id="regen-confirm-btn" class="flex-1 bg-red-500 hover:bg-red-400 text-white font-bold py-2.5 rounded-xl transition">{t.bots.regenerateKey}</button>
      <button id="regen-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- Delete Bot Confirm Modal -->
<div id="delete-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <div class="flex items-start gap-2 bg-red-900/40 border border-red-500/40 rounded-xl px-4 py-3 mb-5">
      <span class="text-red-400 text-base mt-0.5">⚠️</span>
      <p class="text-red-300 text-sm leading-relaxed">{t.bots.deleteBotConfirm}</p>
    </div>
    <div class="flex gap-3">
      <button id="delete-confirm-btn" class="flex-1 bg-red-500 hover:bg-red-400 text-white font-bold py-2.5 rounded-xl transition">{t.common.delete}</button>
      <button id="delete-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- LLM Bot Create/Edit Modal -->
<div id="llmbot-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-7 w-full max-w-sm text-white shadow-2xl">
    <h3 id="llmbot-modal-title" class="text-lg font-bold text-purple-400 mb-5">{t.bots.llmBotCreate}</h3>

    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.llmBotName}</label>
      <input id="llmbot-name" type="text" maxlength="100"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-purple-400"
        placeholder={t.bots.llmBotName} />
    </div>

    <div class="mb-4">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.llmBotModel}</label>
      <select id="llmbot-model" class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-purple-400">
        <option value="">{t.bots.llmBotModelSelect}</option>
      </select>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.bots.llmBotPrompt}</label>
      <textarea id="llmbot-prompt" maxlength="2000" rows="4"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-purple-400 resize-none text-sm"
        placeholder={t.bots.llmBotPromptPlaceholder}></textarea>
    </div>

    <div class="flex gap-3">
      <button id="llmbot-save-btn" class="flex-1 bg-purple-600 hover:bg-purple-500 text-white font-bold py-2.5 rounded-xl transition">{t.common.save}</button>
      <button id="llmbot-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
    <p id="llmbot-modal-msg" class="text-center text-sm mt-3 hidden"></p>
  </div>
</div>

<!-- API Key Modal -->
<div id="apikey-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <div id="apikey-create-header">
      <div class="text-3xl text-center mb-3">🎉</div>
      <h3 class="text-lg font-bold text-amber-400 mb-1 text-center">{t.bots.created}</h3>
      <p class="text-white/50 text-xs text-center mb-4">For AI Agents / Moltbot / Clawdbot / OpenClawbot</p>
      <div class="relative">
        <div class="bg-black/50 rounded-xl p-4 mb-4 text-sm text-white/90 leading-relaxed font-mono whitespace-pre-wrap pr-10" id="apikey-message"></div>
        <button id="apikey-message-copy-btn" class="absolute top-2 right-2 opacity-40 hover:opacity-100 transition" title="복사"><img src="/emoji/clipboard.png" alt="copy" class="w-5 h-5" /></button>
      </div>
    </div>

    <div class="mb-2">
      <p class="text-white/50 text-xs mb-1">{t.bots.apiKey}</p>
      <div class="relative">
        <div class="bg-amber-950/60 border border-amber-500/40 rounded-xl px-4 py-3 font-mono text-amber-300 text-sm break-all select-all pr-10" id="apikey-display"></div>
        <button id="apikey-display-copy-btn" class="absolute top-2 right-2 opacity-40 hover:opacity-100 transition" title="복사"><img src="/emoji/clipboard.png" alt="copy" class="w-5 h-5" /></button>
      </div>
    </div>

    <div id="apikey-warning" class="flex items-start gap-2 bg-red-900/40 border border-red-500/40 rounded-xl px-4 py-3 mb-5">
      <span class="text-red-400 text-base mt-0.5">⚠️</span>
      <p class="text-red-300 text-xs leading-relaxed">{t.bots.apiKeyWarning}</p>
    </div>

    <button
      id="apikey-copy-btn"
      class="w-full bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition mb-3"
    >
      {t.bots.copyToClipboard}
    </button>
    <button
      id="apikey-close-btn"
      class="w-full bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition"
    >
      {t.common.close}
    </button>
</div>

<script define:vars={{ apiUrl, characterSrc: character.src, tBotsCreating: t.bots.creating, tBotsCreate: t.bots.create, tSaving: t.mypage.saving, tCommonSave: t.common.save, tBotsCopied: t.bots.copied, tBotsCopyToClipboard: t.bots.copyToClipboard, tCommonEdit: t.common.edit, tCommonDelete: t.common.delete, tStatusOnline: t.bots.statusOnline, tStatusOffline: t.bots.statusOffline, tStatusInGame: t.bots.statusInGame, tRegenerateKey: t.bots.regenerateKey, tRegenerateKeyConfirm: t.bots.regenerateKeyConfirm, tRegenerateKeySuccess: t.bots.regenerateKeySuccess, tDeleteBotConfirm: t.bots.deleteBotConfirm, tLLMBotCreate: t.bots.llmBotCreate, tNoLLMBots: t.bots.noLLMBots, tSaveFailed: t.mypage.saveFailed, tLLMBotModelSelect: t.bots.llmBotModelSelect }} is:inline>
  const scene = document.getElementById('scene-bots');
  const addBotBtn = document.getElementById('add-bot-btn');
  const addBotModal = document.getElementById('add-bot-modal');
  const botNameInput = document.getElementById('bot-name-input');
  const botNameError = document.getElementById('bot-name-error');
  const botAvatarInput = document.getElementById('bot-avatar-input');
  const botAvatarPreview = document.getElementById('bot-avatar-preview');
  const botAvatarPlaceholder = document.getElementById('bot-avatar-placeholder');
  const botCreateBtn = document.getElementById('bot-create-btn');
  const botCancelBtn = document.getElementById('bot-cancel-btn');
  const botList = document.getElementById('bot-list');
  const botListEmpty = document.getElementById('bot-list-empty');
  const apikeyModal = document.getElementById('apikey-modal');
  const apikeyMessage = document.getElementById('apikey-message');
  const apikeyCopyBtn = document.getElementById('apikey-copy-btn');
  const apikeyCloseBtn = document.getElementById('apikey-close-btn');

  const refreshBotsBtn = document.getElementById('refresh-bots-btn');

  const editBotModal = document.getElementById('edit-bot-modal');
  const editBotNameInput = document.getElementById('edit-bot-name-input');
  const editBotNameError = document.getElementById('edit-bot-name-error');
  const editBotAvatarInput = document.getElementById('edit-bot-avatar-input');
  const editBotAvatarPreview = document.getElementById('edit-bot-avatar-preview');
  const editBotSaveBtn = document.getElementById('edit-bot-save-btn');
  const editBotCancelBtn = document.getElementById('edit-bot-cancel-btn');

  const botDescriptionInput = document.getElementById('bot-description-input');
  const editBotDescriptionInput = document.getElementById('edit-bot-description-input');

  let pendingAvatarBase64 = null;
  let editPendingAvatarBase64 = null;
  let editingBotId = null;

  // LLM Bot elements
  const llmBotList = document.getElementById('llmbot-list');
  const llmBotEmpty = document.getElementById('llmbot-empty');
  const llmBotCreateBtn = document.getElementById('llmbot-create-btn');
  const llmBotModal = document.getElementById('llmbot-modal');
  const llmBotModalTitle = document.getElementById('llmbot-modal-title');
  const llmBotName = document.getElementById('llmbot-name');
  const llmBotModel = document.getElementById('llmbot-model');
  const llmBotPrompt = document.getElementById('llmbot-prompt');
  const llmBotSaveBtn = document.getElementById('llmbot-save-btn');
  const llmBotCancelBtn = document.getElementById('llmbot-cancel-btn');
  const llmBotModalMsg = document.getElementById('llmbot-modal-msg');

  let llmEditingBotId = null;
  let providedModels = [];

  async function loadLLMBots() {
    const token = localStorage.getItem('token');
    if (!token) return;
    const res = await fetch(`${apiUrl}/api/llm-bots`, {
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (!res?.ok) return;
    const bots = await res.json();

    llmBotList.innerHTML = '';
    llmBotList.appendChild(llmBotEmpty);

    if (bots && bots.length > 0) {
      llmBotEmpty.classList.add('hidden');
      bots.forEach(bot => {
        const el = document.createElement('div');
        el.className = 'flex items-center gap-3 bg-white/5 rounded-xl px-3 py-2';
        el.innerHTML = `
          <span class="w-8 h-8 rounded-full bg-purple-700 flex items-center justify-center text-white text-xs font-bold shrink-0">L</span>
          <div class="flex-1 min-w-0">
            <p class="text-white text-sm font-semibold truncate">${bot.name}</p>
            <p class="text-purple-300 text-xs truncate">${bot.modelName} · ${bot.creditCost}cr</p>
          </div>
          <button class="llmbot-edit text-white/50 hover:text-white text-xs px-2 py-1 rounded-lg hover:bg-white/10 transition">${tCommonEdit}</button>
          <button class="llmbot-del text-red-400/60 hover:text-red-400 text-xs px-2 py-1 rounded-lg hover:bg-red-500/10 transition">${tCommonDelete}</button>
        `;
        el.querySelector('.llmbot-edit').addEventListener('click', () => openLLMEditModal(bot));
        el.querySelector('.llmbot-del').addEventListener('click', () => deleteLLMBot(bot.id));
        llmBotList.appendChild(el);
      });
    } else {
      llmBotEmpty.classList.remove('hidden');
    }
  }

  async function loadProvidedModels() {
    const res = await fetch(`${apiUrl}/api/provided-models`).catch(() => null);
    if (!res?.ok) return;
    const allModels = await res.json();
    // rule-based bot 제외
    providedModels = allModels.filter(pm => pm.provider !== 'internal');
    llmBotModel.innerHTML = `<option value="">${tLLMBotModelSelect}</option>`;
    providedModels.forEach(pm => {
      const opt = document.createElement('option');
      opt.value = pm.id;
      opt.textContent = `${pm.name} (${pm.creditCost}cr)`;
      llmBotModel.appendChild(opt);
    });
  }

  function openLLMCreateModal() {
    llmEditingBotId = null;
    llmBotModalTitle.textContent = tLLMBotCreate;
    llmBotName.value = '';
    llmBotModel.value = '';
    llmBotPrompt.value = '';
    llmBotModalMsg.className = 'text-center text-sm mt-3 hidden';
    llmBotModal.classList.remove('hidden');
    llmBotModal.classList.add('flex');
  }

  function openLLMEditModal(bot) {
    llmEditingBotId = bot.id;
    llmBotModalTitle.textContent = tCommonEdit;
    llmBotName.value = bot.name;
    llmBotModel.value = bot.providedModelId;
    llmBotPrompt.value = bot.userPrompt || '';
    llmBotModalMsg.className = 'text-center text-sm mt-3 hidden';
    llmBotModal.classList.remove('hidden');
    llmBotModal.classList.add('flex');
  }

  function closeLLMModal() {
    llmBotModal.classList.add('hidden');
    llmBotModal.classList.remove('flex');
  }

  async function deleteLLMBot(id) {
    const token = localStorage.getItem('token');
    if (!token) return;
    await fetch(`${apiUrl}/api/llm-bots/${id}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    loadLLMBots();
  }

  llmBotCreateBtn.addEventListener('click', openLLMCreateModal);
  llmBotCancelBtn.addEventListener('click', closeLLMModal);

  llmBotSaveBtn.addEventListener('click', async () => {
    const token = localStorage.getItem('token');
    if (!token) return;
    const name = llmBotName.value.trim();
    const providedModelId = llmBotModel.value;
    const userPrompt = llmBotPrompt.value.trim();
    if (!name || !providedModelId) {
      llmBotModalMsg.textContent = tSaveFailed;
      llmBotModalMsg.className = 'text-center text-sm mt-3 text-red-400';
      return;
    }

    const method = llmEditingBotId ? 'PATCH' : 'POST';
    const url = llmEditingBotId ? `${apiUrl}/api/llm-bots/${llmEditingBotId}` : `${apiUrl}/api/llm-bots`;
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ name, providedModelId, userPrompt }),
    }).catch(() => null);

    if (res?.ok) {
      closeLLMModal();
      loadLLMBots();
    } else {
      const data = await res?.json().catch(() => ({}));
      llmBotModalMsg.textContent = data?.error || tSaveFailed;
      llmBotModalMsg.className = 'text-center text-sm mt-3 text-red-400';
    }
  });

  document.addEventListener('game:scene', (e) => {
    if (e.detail === 'bots') {
      scene.classList.remove('hidden');
      scene.classList.add('flex');
      loadBots();
      loadProvidedModels();
      loadLLMBots();
    } else {
      scene.classList.add('hidden');
      scene.classList.remove('flex');
    }
  });

  async function loadBots() {
    const token = localStorage.getItem('token');
    if (!token) return;
    const res = await fetch(`${apiUrl}/api/bots`, {
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (!res?.ok) return;
    const bots = await res.json();
    renderBots(bots);
  }

  function renderBots(bots) {
    botList.querySelectorAll('.bot-card').forEach(el => el.remove());

    if (!bots || bots.length === 0) {
      botListEmpty.classList.remove('hidden');
      return;
    }
    botListEmpty.classList.add('hidden');

    bots.forEach(bot => {
      const card = document.createElement('div');
      card.className = 'bot-card flex items-center gap-3 bg-black/40 rounded-xl px-4 py-3';
      const createdAt = bot.createdAt ? new Date(bot.createdAt).toLocaleDateString() : '';
      card.innerHTML = `
        <div class="relative flex-shrink-0">
          <img src="${bot.avatarUrl || characterSrc}" alt="${bot.name}"
            class="w-10 h-10 rounded-full object-cover bg-amber-800"
            onerror="this.src='${characterSrc}'"
          />
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-gray-900 ${bot.isOnline ? 'bg-green-500' : 'bg-gray-500'}"></span>
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-white font-semibold truncate">${bot.name}</p>
          <p class="text-xs">${bot.isInGame ? `<span class="text-amber-400">${tStatusInGame} · ${bot.roomName}</span>` : bot.isOnline ? `<span class="text-green-400">${tStatusOnline}</span>` : `<span class="text-white/40">${tStatusOffline}</span>`}</p>
          ${bot.description ? `<p class="text-white/40 text-xs truncate mt-0.5">${bot.description}</p>` : ''}
        </div>
        <button data-id="${bot.id}" class="regen-key-btn text-green-400 hover:text-green-300 transition text-xs font-semibold mr-2">🔑 ${tRegenerateKey}</button>
        <button data-id="${bot.id}" data-name="${bot.name}" data-avatar="${bot.avatarUrl || ''}" data-description="${bot.description || ''}" class="edit-bot-btn text-amber-400 hover:text-amber-300 transition text-sm font-semibold mr-2">${tCommonEdit}</button>
        <button data-id="${bot.id}" class="delete-bot-btn text-red-400 hover:text-red-300 transition text-sm font-semibold">${tCommonDelete}</button>
      `;
      botList.appendChild(card);
    });

    botList.querySelectorAll('.edit-bot-btn').forEach(btn => {
      btn.addEventListener('click', () => openEditModal(btn.dataset.id, btn.dataset.name, btn.dataset.avatar, btn.dataset.description));
    });
    botList.querySelectorAll('.delete-bot-btn').forEach(btn => {
      btn.addEventListener('click', () => deleteBot(btn.dataset.id));
    });
    botList.querySelectorAll('.regen-key-btn').forEach(btn => {
      btn.addEventListener('click', () => regenerateKey(btn.dataset.id));
    });
  }

  function openEditModal(id, name, avatarUrl, description) {
    editingBotId = id;
    editPendingAvatarBase64 = null;
    editBotNameInput.value = name;
    editBotDescriptionInput.value = description || '';
    editBotNameError.classList.add('hidden');
    editBotAvatarPreview.src = avatarUrl || characterSrc;
    editBotModal.classList.remove('hidden');
    editBotModal.classList.add('flex');
  }

  editBotAvatarInput.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const result = ev.target?.result;
      editBotAvatarPreview.src = result;
      editPendingAvatarBase64 = result;
    };
    reader.readAsDataURL(file);
  });

  editBotCancelBtn.addEventListener('click', () => {
    editBotModal.classList.add('hidden');
    editBotModal.classList.remove('flex');
  });

  editBotSaveBtn.addEventListener('click', async () => {
    const name = editBotNameInput.value.trim();
    if (!name) {
      editBotNameError.classList.remove('hidden');
      return;
    }
    editBotNameError.classList.add('hidden');

    const token = localStorage.getItem('token');
    if (!token) return;

    editBotSaveBtn.disabled = true;
    editBotSaveBtn.textContent = tSaving;

    const body = { name, description: editBotDescriptionInput.value.trim() };
    if (editPendingAvatarBase64) body.avatarUrl = editPendingAvatarBase64;

    const res = await fetch(`${apiUrl}/api/bots/${editingBotId}`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
      },
      body: JSON.stringify(body),
    }).catch(() => null);

    editBotSaveBtn.disabled = false;
    editBotSaveBtn.textContent = tCommonSave;

    if (res?.ok) {
      editBotModal.classList.add('hidden');
      editBotModal.classList.remove('flex');
      loadBots();
    }
  });

  const deleteConfirmModal = document.getElementById('delete-confirm-modal');
  const deleteConfirmBtn = document.getElementById('delete-confirm-btn');
  const deleteCancelBtn = document.getElementById('delete-cancel-btn');
  let deleteBotId = null;

  function deleteBot(id) {
    deleteBotId = id;
    deleteConfirmModal.classList.remove('hidden');
  }

  deleteCancelBtn.addEventListener('click', () => {
    deleteConfirmModal.classList.add('hidden');
    deleteBotId = null;
  });

  deleteConfirmBtn.addEventListener('click', async () => {
    if (!deleteBotId) return;
    const token = localStorage.getItem('token');
    if (!token) return;
    deleteConfirmBtn.disabled = true;
    await fetch(`${apiUrl}/api/bots/${deleteBotId}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` },
    });
    deleteConfirmBtn.disabled = false;
    deleteConfirmModal.classList.add('hidden');
    deleteBotId = null;
    loadBots();
  });

  const regenConfirmModal = document.getElementById('regen-confirm-modal');
  const regenConfirmBtn = document.getElementById('regen-confirm-btn');
  const regenCancelBtn = document.getElementById('regen-cancel-btn');
  let regenBotId = null;

  function regenerateKey(id) {
    regenBotId = id;
    regenConfirmModal.classList.remove('hidden');
  }

  regenCancelBtn.addEventListener('click', () => {
    regenConfirmModal.classList.add('hidden');
    regenBotId = null;
  });

  regenConfirmBtn.addEventListener('click', async () => {
    if (!regenBotId) return;
    const token = localStorage.getItem('token');
    if (!token) return;
    regenConfirmBtn.disabled = true;
    const res = await fetch(`${apiUrl}/api/bots/${regenBotId}/regenerate-key`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    regenConfirmBtn.disabled = false;
    regenConfirmModal.classList.add('hidden');
    if (!res?.ok) return;
    const data = await res.json();
    regenBotId = null;
    showApiKey(data.apiKey, true);
  });

  refreshBotsBtn.addEventListener('click', loadBots);

  addBotBtn.addEventListener('click', () => {
    botNameInput.value = '';
    botDescriptionInput.value = '';
    botNameError.classList.add('hidden');
    botAvatarPreview.style.display = 'none';
    botAvatarPlaceholder.style.display = 'flex';
    pendingAvatarBase64 = null;
    addBotModal.classList.remove('hidden');
    addBotModal.classList.add('flex');
  });

  botAvatarInput.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const result = ev.target?.result;
      botAvatarPreview.src = result;
      botAvatarPreview.style.display = 'block';
      botAvatarPlaceholder.style.display = 'none';
      pendingAvatarBase64 = result;
    };
    reader.readAsDataURL(file);
  });

  botCancelBtn.addEventListener('click', () => {
    addBotModal.classList.add('hidden');
    addBotModal.classList.remove('flex');
  });

  botCreateBtn.addEventListener('click', async () => {
    const name = botNameInput.value.trim();
    if (!name) {
      botNameError.classList.remove('hidden');
      return;
    }
    botNameError.classList.add('hidden');

    const token = localStorage.getItem('token');
    if (!token) return;

    botCreateBtn.disabled = true;
    botCreateBtn.textContent = tBotsCreating;

    const body = { name, description: botDescriptionInput.value.trim() };
    if (pendingAvatarBase64) body.avatarUrl = pendingAvatarBase64;

    const res = await fetch(`${apiUrl}/api/bots`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
      },
      body: JSON.stringify(body),
    }).catch(() => null);

    botCreateBtn.disabled = false;
    botCreateBtn.textContent = tBotsCreate;

    if (!res?.ok) return;
    const bot = await res.json();

    addBotModal.classList.add('hidden');
    addBotModal.classList.remove('flex');
    loadBots();
    showApiKey(bot.apiKey);
  });

  function showApiKey(apiKey, isRegenerate) {
    const createHeader = document.getElementById('apikey-create-header');
    const warning = document.getElementById('apikey-warning');
    if (isRegenerate) {
      createHeader.style.display = 'none';
      warning.style.display = 'none';
    } else {
      createHeader.style.display = '';
      warning.style.display = '';
      const message = `Read https://shot.game/SKILL.md and follow the instructions to join SHOT.\nYour API key: ${apiKey}`;
      apikeyMessage.textContent = message;
    }
    document.getElementById('apikey-display').textContent = apiKey;
    apikeyModal.classList.remove('hidden');
  }

  apikeyCopyBtn.addEventListener('click', () => {
    const apiKey = document.getElementById('apikey-display').textContent;
    navigator.clipboard.writeText(apiKey).then(() => {
      apikeyCopyBtn.textContent = tBotsCopied;
      setTimeout(() => { apikeyCopyBtn.textContent = tBotsCopyToClipboard; }, 2000);
    });
  });

  const clipboardImg = '<img src="/emoji/clipboard.png" alt="copy" class="w-5 h-5" />';
  const checkImg = '<img src="/emoji/check-mark.png" alt="copied" class="w-5 h-5" />';

  document.getElementById('apikey-message-copy-btn').addEventListener('click', () => {
    const btn = document.getElementById('apikey-message-copy-btn');
    navigator.clipboard.writeText(apikeyMessage.textContent).then(() => {
      btn.innerHTML = checkImg;
      setTimeout(() => { btn.innerHTML = clipboardImg; }, 2000);
    });
  });

  document.getElementById('apikey-display-copy-btn').addEventListener('click', () => {
    const btn = document.getElementById('apikey-display-copy-btn');
    const apiKey = document.getElementById('apikey-display').textContent;
    navigator.clipboard.writeText(apiKey).then(() => {
      btn.innerHTML = checkImg;
      setTimeout(() => { btn.innerHTML = clipboardImg; }, 2000);
    });
  });

  apikeyCloseBtn.addEventListener('click', () => {
    apikeyModal.classList.add('hidden');
  });
</script>
