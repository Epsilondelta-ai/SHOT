---
import bulletImg from '../assets/bullet.webp';
import healImg from '../assets/heal.webp';
import handcuffImg from '../assets/handcuff.webp';
import findImg from '../assets/find.webp';
import hittedImg from '../assets/hitted.webp';
import healedImg from '../assets/healed.webp';
import jailImg from '../assets/jail.webp';
import character from '../assets/character.webp';
import { type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';

interface Props {
  apiUrl: string;
  lang: Locale;
}

const { apiUrl, lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="scene-gameplay" class="hidden relative z-10 w-full flex-1 flex-col overflow-hidden min-h-0">
  <div class="flex flex-col flex-1 min-h-0 max-w-6xl mx-auto w-full px-4 py-2 gap-2">

    <!-- Top bar: Turn info + Timer + Chat toggle -->
    <div class="flex items-center justify-between bg-black/40 rounded-2xl px-4 py-2">
      <div class="flex items-center gap-4">
        <span id="gp-turn-info" class="text-white font-bold text-sm"></span>
      </div>
      <div class="flex items-center gap-3">
        <div id="gp-timer" class="text-amber-400 font-mono font-bold text-lg">2:00</div>
        <div id="gp-sse-status" title="SSE connection">
          <span id="gp-sse-dot" class="inline-block w-2.5 h-2.5 rounded-full bg-green-500"></span>
        </div>
        <button id="gp-chat-toggle" class="bg-white/10 hover:bg-white/20 text-white px-3 py-1 rounded-xl text-xs transition">{t.rooms.chat}</button>
      </div>
    </div>

    <!-- Main area: Players + Info bar -->
    <div class="flex flex-col sm:flex-row flex-1 min-h-0 gap-2">

      <!-- Players area -->
      <div class="flex-1 relative flex items-center justify-center min-h-0">
        <div id="gp-players" class="relative w-full h-full flex items-center justify-center"></div>
        <div id="gp-effects" class="absolute inset-0 pointer-events-none"></div>
      </div>

      <!-- Side panel (desktop only) -->
      <div class="hidden sm:flex flex-col gap-2 w-48 flex-shrink-0">
        <div id="gp-my-info" class="bg-black/40 rounded-2xl px-4 py-3">
          <p id="gp-my-role" class="text-white font-bold text-base mb-1"></p>
          <div class="flex items-center gap-1">
            <span class="text-white/50 text-xs">HP:</span>
            <div id="gp-my-hp" class="flex gap-0.5"></div>
          </div>
          <p id="gp-my-status" class="text-white/40 text-xs mt-1"></p>
        </div>
        <div class="flex flex-col gap-2">
          <button id="gp-end-turn-btn" class="w-full bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2 rounded-xl text-sm transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>{t.game.turn.endTurn}</button>
          <button id="gp-reveal-btn" class="hidden w-full bg-red-500 hover:bg-red-400 text-white font-bold py-2 rounded-xl text-sm transition">{t.game.reveal.button}</button>
          <button id="gp-leave-btn" class="hidden w-full bg-white/10 hover:bg-white/20 text-white py-2 rounded-xl text-sm transition">{t.game.leave.dead}</button>
        </div>
      </div>
    </div>

    <!-- Mobile info bar (mobile only) -->
    <div class="sm:hidden flex items-center gap-3 bg-black/40 rounded-xl px-3 py-2">
      <p id="gp-my-role-mobile" class="text-white font-bold text-sm"></p>
      <div class="flex items-center gap-1">
        <span class="text-white/50 text-xs">HP:</span>
        <div id="gp-my-hp-mobile" class="flex gap-0.5"></div>
      </div>
      <p id="gp-my-status-mobile" class="text-white/40 text-xs"></p>
      <div class="ml-auto flex gap-2">
        <button id="gp-end-turn-btn-mobile" class="bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-3 py-1.5 rounded-xl text-xs transition disabled:opacity-40 disabled:cursor-not-allowed" disabled>{t.game.turn.endTurn}</button>
        <button id="gp-reveal-btn-mobile" class="hidden bg-red-500 hover:bg-red-400 text-white font-bold px-3 py-1.5 rounded-xl text-xs transition">{t.game.reveal.button}</button>
        <button id="gp-leave-btn-mobile" class="hidden bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 rounded-xl text-xs transition">{t.game.leave.dead}</button>
      </div>
    </div>

    <!-- Card hand (Slay the Spire style) -->
    <div id="gp-card-hand" class="relative flex justify-center items-end" style="height:50px;">
      <div id="gp-my-cards" class="relative flex justify-center items-end" style="height:120px;"></div>
    </div>

  </div>

  <!-- Game chat (toggleable, overlay at bottom) -->
  <div id="gp-chat-panel" class="hidden absolute bottom-0 left-0 right-0 z-30 bg-black/90 rounded-t-2xl overflow-hidden" style="height:220px;">
    <div class="flex flex-col h-full max-w-6xl mx-auto w-full">
      <div id="gp-chat-messages" class="flex-1 overflow-y-auto p-3 flex flex-col gap-1 min-h-0"></div>
      <div class="flex gap-2 p-2 border-t border-white/10">
        <input id="gp-chat-input" type="text" maxlength="300"
          placeholder={t.game.chat.placeholder}
          class="flex-1 bg-white/10 border border-white/20 rounded-xl px-3 py-1.5 text-white placeholder-white/30 text-xs focus:outline-none focus:ring-2 focus:ring-amber-400" />
        <button id="gp-chat-send" class="bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-3 py-1.5 rounded-xl text-xs transition">{t.rooms.chatSend}</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  #gp-card-hand {
    overflow: visible;
    pointer-events: auto;
  }
  .card-hand-item {
    position: absolute;
    bottom: 0;
    width: 80px;
    height: 120px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.12);
    background: linear-gradient(180deg, #1e1e3a 0%, #16213e 100%);
    cursor: pointer;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.25s, box-shadow 0.25s;
    transform-origin: bottom center;
    /* Peek: pushed down, only top ~40px visible */
    transform: translateY(80px) rotate(var(--card-angle, 0deg));
  }
  /* Container hover or touch-active → reveal all cards */
  #gp-card-hand:hover .card-hand-item,
  #gp-card-hand.hand-active .card-hand-item {
    transform: translateY(var(--card-y-fan, 0px)) rotate(var(--card-angle, 0deg));
  }
  /* Individual card hover → pop up */
  #gp-card-hand:hover .card-hand-item:hover,
  #gp-card-hand.hand-active .card-hand-item.card-touched {
    transform: translateY(-25px) scale(1.1) rotate(0deg) !important;
    z-index: 50 !important;
    border-color: rgba(255,255,255,0.5);
    box-shadow: 0 12px 32px rgba(0,0,0,0.7);
  }
  /* Selected card always popped */
  .card-hand-item.card-selected {
    transform: translateY(-25px) scale(1.1) rotate(0deg) !important;
    z-index: 50 !important;
  }
  .card-hand-item.card-disabled {
    cursor: not-allowed;
    filter: saturate(0.4) brightness(0.8);
  }
  .card-hand-item.card-disabled::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.35);
    border-radius: 10px;
    pointer-events: none;
  }
  /* Disabled cards rise with the hand but don't pop up individually */
  #gp-card-hand:hover .card-hand-item.card-disabled:hover,
  #gp-card-hand.hand-active .card-hand-item.card-disabled.card-touched {
    transform: translateY(var(--card-y-fan, 0px)) rotate(var(--card-angle, 0deg)) !important;
    border-color: rgba(255,255,255,0.08);
    box-shadow: none;
  }
  /* Card inner structure */
  .card-hand-item .card-header {
    padding: 5px 4px 2px;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
    color: white;
    text-shadow: 0 1px 2px rgba(0,0,0,0.8);
  }
  .card-hand-item .card-art {
    width: 56px;
    height: 56px;
    margin: 2px auto;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(0,0,0,0.3);
  }
  .card-hand-item .card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .card-hand-item .card-desc {
    padding: 3px 5px;
    font-size: 7px;
    text-align: center;
    color: rgba(255,255,255,0.5);
    line-height: 1.3;
  }
  /* Type-specific colors */
  .card-type-attack { border-color: rgba(239,68,68,0.4); background: linear-gradient(180deg, #2a1520 0%, #1a1028 100%); }
  .card-type-attack .card-header { color: #fca5a5; }
  .card-type-heal { border-color: rgba(34,197,94,0.4); background: linear-gradient(180deg, #0f2518 0%, #101e28 100%); }
  .card-type-heal .card-header { color: #86efac; }
  .card-type-jail { border-color: rgba(139,92,246,0.4); background: linear-gradient(180deg, #1a1530 0%, #151828 100%); }
  .card-type-jail .card-header { color: #c4b5fd; }
  .card-type-inspect { border-color: rgba(234,179,8,0.4); background: linear-gradient(180deg, #2a2210 0%, #1a1828 100%); }
  .card-type-inspect .card-header { color: #fde047; }
  /* Selected glow per type */
  .card-type-attack.card-selected { border-color: #ef4444; box-shadow: 0 0 20px rgba(239,68,68,0.5); }
  .card-type-heal.card-selected { border-color: #22c55e; box-shadow: 0 0 20px rgba(34,197,94,0.5); }
  .card-type-jail.card-selected { border-color: #8b5cf6; box-shadow: 0 0 20px rgba(139,92,246,0.5); }
  .card-type-inspect.card-selected { border-color: #eab308; box-shadow: 0 0 20px rgba(234,179,8,0.5); }
  /* Chat available blink */
  @keyframes chat-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  #gp-chat-toggle.chat-available {
    animation: chat-blink 1.2s ease-in-out infinite;
    background: rgba(251,191,36,0.3);
    border: 1px solid rgba(251,191,36,0.5);
  }
  /* When chat is open, disable card hand interaction */
  #gp-card-hand.chat-open {
    pointer-events: none;
  }
  #gp-card-hand.chat-open .card-hand-item {
    transform: translateY(80px) rotate(var(--card-angle, 0deg)) !important;
  }
  @media (max-width: 639px) {
    .card-hand-item {
      width: 68px;
      height: 100px;
    }
    .card-hand-item .card-art {
      width: 46px;
      height: 46px;
    }
    .card-hand-item {
      transform: translateY(65px) rotate(var(--card-angle, 0deg));
    }
    #gp-card-hand:hover .card-hand-item.card-disabled,
    #gp-card-hand.hand-active .card-hand-item.card-disabled {
      transform: translateY(65px) rotate(var(--card-angle, 0deg)) !important;
    }
    #gp-card-hand.chat-open .card-hand-item {
      transform: translateY(65px) rotate(var(--card-angle, 0deg)) !important;
    }
  }
</style>

<!-- Target selection indicator -->
<div id="gp-target-indicator" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-amber-500 text-gray-900 font-bold px-4 py-2 rounded-xl text-sm shadow-lg">
  {t.game.action.selectTarget}
  <button id="gp-cancel-target" class="ml-2 bg-gray-900/30 px-2 py-0.5 rounded text-xs">{t.common.cancel}</button>
</div>

<!-- Game result modal -->
<div id="gp-result-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/80 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl text-center">
    <h2 id="gp-result-title" class="text-3xl font-bold mb-2"></h2>
    <p id="gp-result-subtitle" class="text-white/60 text-sm mb-6"></p>
    <div id="gp-result-players" class="flex flex-wrap justify-center gap-3 mb-6"></div>
    <div class="flex gap-3">
      <button id="gp-result-replay" class="flex-1 bg-white/10 hover:bg-white/20 text-white py-2.5 rounded-xl transition">{t.game.result.watchReplay}</button>
      <button id="gp-result-lobby" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.game.result.backToLobby}</button>
    </div>
  </div>
</div>

<script define:vars={{
  apiUrl,
  lang,
  characterSrc: character.src,
  bulletSrc: bulletImg.src,
  healSrc: healImg.src,
  handcuffSrc: handcuffImg.src,
  findSrc: findImg.src,
  hittedSrc: hittedImg.src,
  healedSrc: healedImg.src,
  jailSrc: jailImg.src,
  tYourTurn: t.game.turn.yourTurn,
  tWaiting: t.game.turn.waiting,
  tTurnInfo: t.game.turn.turnInfo,
  tEndTurn: t.game.turn.endTurn,
  tMustAttack: t.game.action.mustAttack,
  tSelectTarget: t.game.action.selectTarget,
  tAgent: t.game.role.agent,
  tSpy: t.game.role.spy,
  tUnknown: t.game.role.unknown,
  tConfirmedAgent: t.game.role.confirmedAgent,
  tJailed: t.game.status.jailed,
  tDead: t.game.status.dead,
  tAgentWin: t.game.result.agentWin,
  tSpyWin: t.game.result.spyWin,
  tDraw: t.game.result.draw,
  tVictory: t.game.result.victory,
  tDefeat: t.game.result.defeat,
  tChatLimit: t.game.chat.limit,
  tRevealConfirm: t.game.reveal.confirm,
  tOverflowDiscarded: t.game.overflow.discarded,
  tLeaveNotAllowed: t.game.leave.notAllowed,
}} is:inline>
  const scene = document.getElementById('scene-gameplay');
  const playersEl = document.getElementById('gp-players');
  const effectsEl = document.getElementById('gp-effects');
  const turnInfoEl = document.getElementById('gp-turn-info');
  const timerEl = document.getElementById('gp-timer');
  const myRoleEl = document.getElementById('gp-my-role');
  const myHPEl = document.getElementById('gp-my-hp');
  const myStatusEl = document.getElementById('gp-my-status');
  const myCardsEl = document.getElementById('gp-my-cards');
  const endTurnBtn = document.getElementById('gp-end-turn-btn');
  const revealBtn = document.getElementById('gp-reveal-btn');
  const leaveBtn = document.getElementById('gp-leave-btn');
  const chatToggle = document.getElementById('gp-chat-toggle');
  const chatPanel = document.getElementById('gp-chat-panel');
  const chatMessages = document.getElementById('gp-chat-messages');
  const chatInput = document.getElementById('gp-chat-input');
  const chatSend = document.getElementById('gp-chat-send');
  const targetIndicator = document.getElementById('gp-target-indicator');
  const cancelTargetBtn = document.getElementById('gp-cancel-target');
  const resultModal = document.getElementById('gp-result-modal');
  const resultTitle = document.getElementById('gp-result-title');
  const resultSubtitle = document.getElementById('gp-result-subtitle');
  const resultPlayers = document.getElementById('gp-result-players');
  const resultReplay = document.getElementById('gp-result-replay');
  const resultLobby = document.getElementById('gp-result-lobby');

  const cardImages = { attack: bulletSrc, heal: healSrc, jail: handcuffSrc, inspect: findSrc };
  const effectImages = { attack: hittedSrc, heal: healedSrc, jail: jailSrc };

  let gameState = null;
  let myPlayerID = null;
  let selectedCard = null;
  let timerInterval = null;

  function getToken() { return localStorage.getItem('token'); }

  function formatTime(seconds) {
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  }

  function startTimerCountdown() {
    if (timerInterval) clearInterval(timerInterval);
    timerInterval = setInterval(() => {
      if (!gameState) return;
      const remaining = Math.max(0, gameState.turnDeadline - Math.floor(Date.now() / 1000));
      timerEl.textContent = formatTime(remaining);
      if (remaining <= 30) {
        timerEl.classList.add('text-red-400');
        timerEl.classList.remove('text-amber-400');
      } else {
        timerEl.classList.add('text-amber-400');
        timerEl.classList.remove('text-red-400');
      }
    }, 250);
  }

  function isMyTurn() {
    return gameState && gameState.currentPlayerID === myPlayerID;
  }

  function getMyPlayer() {
    return gameState?.players?.find(p => p.id === myPlayerID);
  }

  function renderPlayers() {
    if (!gameState) return;
    playersEl.innerHTML = '';
    const players = gameState.players;
    const count = players.length;
    const cx = playersEl.clientWidth / 2;
    const cy = playersEl.clientHeight / 2;
    const rx = Math.min(cx - 50, 220);
    const ry = Math.min(cy - 40, 160);

    players.forEach((p, i) => {
      const angle = (2 * Math.PI * i / count) - Math.PI / 2;
      const x = cx + rx * Math.cos(angle) - 36;
      const y = cy + ry * Math.sin(angle) - 36;

      const isCurrentTurn = p.id === gameState.currentPlayerID;
      const borderColor = p.isDead ? (p.role === 'spy' ? 'border-red-500' : 'border-blue-400') :
                          p.isRevealed ? 'border-red-500' :
                          p.isConfirmedAgent ? 'border-blue-400' :
                          'border-white/20';

      const el = document.createElement('div');
      el.className = `absolute flex flex-col items-center gap-0.5 transition-all duration-300`;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      el.style.width = '72px';
      el.id = `gp-player-${p.id}`;

      const badge = p.isDead ? (p.role === 'spy' ? '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Symbols/Red%20Circle.png" alt="spy" class="inline-block w-4 h-4" />' : '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Objects/Shield.png" alt="agent" class="inline-block w-4 h-4" />') :
                    p.isRevealed ? '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Symbols/Red%20Circle.png" alt="spy" class="inline-block w-4 h-4" />' :
                    p.isConfirmedAgent ? '<img src="https://raw.githubusercontent.com/Tarikul-Islam-Anik/Animated-Fluent-Emojis/master/Emojis/Objects/Shield.png" alt="agent" class="inline-block w-4 h-4" />' : '';

      el.innerHTML = `
        <div class="relative ${isCurrentTurn ? 'ring-4 ring-amber-400/60 shadow-[0_0_12px_rgba(251,191,36,0.5)] rounded-full' : ''}">
          <img src="${p.avatarUrl || characterSrc}" alt="${p.username}"
            class="w-12 h-12 rounded-full object-cover border-3 ${borderColor} ${p.isDead ? 'opacity-40 grayscale' : ''}"
            onerror="this.src='${characterSrc}'" />
          ${badge ? `<span class="absolute -top-1 -right-1 text-xs">${badge}</span>` : ''}
          ${p.botId ? `<span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-gray-900 ${p.isOnline ? 'bg-green-500' : 'bg-gray-500'}"></span>` : ''}
          ${p.isJailed ? `<img src="${jailSrc}" class="absolute inset-0 w-12 h-12 opacity-60" />` : ''}
        </div>
        <p class="text-xs truncate w-full text-center ${isCurrentTurn ? 'text-amber-400 font-bold' : 'text-white/70'} ${p.isDead ? 'opacity-40' : ''}">${p.username}</p>
        <div class="flex gap-0.5">${renderHPPips(p.hp, p.maxHp)}</div>
        <p class="text-white/30 text-xs">${p.cards ? p.cards.length : 0} cards</p>
        ${p.role !== 'unknown' && p.id !== myPlayerID ? `<p class="text-xs ${p.role === 'spy' ? 'text-red-400' : 'text-blue-400'}">${p.role === 'spy' ? tSpy : p.isConfirmedAgent ? tConfirmedAgent : tAgent}</p>` : ''}
      `;

      // Click/touch to select as target
      if (selectedCard && !p.isDead && p.id !== myPlayerID) {
        el.classList.add('cursor-pointer', 'hover:scale-110');
        el.addEventListener('click', () => playCard(p.id));
        el.addEventListener('touchend', (e) => { e.preventDefault(); playCard(p.id); });
      } else if (selectedCard && !p.isDead && p.id === myPlayerID && selectedCard === 'heal') {
        el.classList.add('cursor-pointer', 'hover:scale-110');
        el.addEventListener('click', () => playCard(p.id));
        el.addEventListener('touchend', (e) => { e.preventDefault(); playCard(p.id); });
      }

      playersEl.appendChild(el);
    });
  }

  function renderHPPips(hp, maxHp) {
    let pips = '';
    for (let i = 0; i < maxHp; i++) {
      pips += `<span class="w-2 h-2 rounded-full ${i < hp ? 'bg-red-500' : 'bg-white/20'}"></span>`;
    }
    return pips;
  }

  function renderMyInfo() {
    const me = getMyPlayer();
    if (!me) return;

    const roleText = me.role === 'spy' ? tSpy : me.role === 'agent' ? tAgent : tUnknown;
    const roleColor = me.role === 'spy' ? 'text-red-400' : me.role === 'agent' ? 'text-blue-400' : 'text-white/50';
    const hpHTML = renderHPPips(me.hp, me.maxHp);
    let status = '';
    if (me.isDead) status = tDead;
    else if (me.isJailed) status = tJailed;

    const canReveal = me.role === 'spy' && !me.isRevealed && isMyTurn();
    const canEndTurn = isMyTurn() && !me.isDead && gameState.phase === 'action';

    // Desktop
    myRoleEl.textContent = roleText;
    myRoleEl.className = `font-bold text-base mb-1 ${roleColor}`;
    myHPEl.innerHTML = hpHTML;
    myStatusEl.textContent = status;
    revealBtn.classList.toggle('hidden', !canReveal);
    leaveBtn.classList.toggle('hidden', !me.isDead);
    endTurnBtn.disabled = !canEndTurn;

    // Mobile
    const myRoleMobile = document.getElementById('gp-my-role-mobile');
    const myHPMobile = document.getElementById('gp-my-hp-mobile');
    const myStatusMobile = document.getElementById('gp-my-status-mobile');
    const endTurnMobile = document.getElementById('gp-end-turn-btn-mobile');
    const revealMobile = document.getElementById('gp-reveal-btn-mobile');
    const leaveMobile = document.getElementById('gp-leave-btn-mobile');

    if (myRoleMobile) { myRoleMobile.textContent = roleText; myRoleMobile.className = `font-bold text-sm ${roleColor}`; }
    if (myHPMobile) myHPMobile.innerHTML = hpHTML;
    if (myStatusMobile) myStatusMobile.textContent = status;
    if (endTurnMobile) endTurnMobile.disabled = !canEndTurn;
    if (revealMobile) revealMobile.classList.toggle('hidden', !canReveal);
    if (leaveMobile) leaveMobile.classList.toggle('hidden', !me.isDead);
  }

  function renderMyCards() {
    const me = getMyPlayer();
    if (!me) return;
    myCardsEl.innerHTML = '';

    const cards = me.cards;
    const count = cards.length;
    const maxFanAngle = 30;
    const fanAngle = Math.min(maxFanAngle, count * 5);
    const cardNames = { attack: 'ATK', heal: 'HEAL', jail: 'JAIL', inspect: 'FIND' };
    const cardDescs = { attack: 'Deal 1 DMG', heal: 'Restore 1 HP', jail: 'Lock 1 turn', inspect: 'Check role' };
    const cardHand = document.getElementById('gp-card-hand');

    // Keep hand active when a card is selected
    if (selectedCard) {
      cardHand.classList.add('hand-active');
    }

    cards.forEach((card, i) => {
      const img = cardImages[card];
      const isDisabled = (me.isJailed && card === 'attack') || !isMyTurn();
      const isSelected = selectedCard === card;

      // Fan layout: angle and offset
      const angleStep = count > 1 ? fanAngle / (count - 1) : 0;
      const angle = count > 1 ? -fanAngle / 2 + angleStep * i : 0;
      const yOffset = Math.abs(angle) * 0.8;

      const el = document.createElement('div');
      el.className = `card-hand-item card-type-${card}${isSelected ? ' card-selected' : ''}${isDisabled ? ' card-disabled' : ''}`;
      el.style.setProperty('--card-angle', `${angle}deg`);
      el.style.setProperty('--card-y-fan', `${yOffset}px`);
      el.style.zIndex = String(i + 1);
      el.style.left = `${i * 48 - (count * 48) / 2 + 24}px`;

      el.innerHTML = `
        <div class="card-header">${cardNames[card] || card}</div>
        <div class="card-art"><img src="${img}" alt="${card}" /></div>
        <div class="card-desc">${cardDescs[card] || ''}</div>
      `;

      // Hover feedback (desktop)
      el.addEventListener('mouseenter', () => el.classList.add('card-touched'));
      el.addEventListener('mouseleave', () => { if (!isSelected) el.classList.remove('card-touched'); });

      // Card selection logic (shared)
      function selectCard() {
        if (isDisabled) return;
        if (selectedCard === card) {
          selectedCard = null;
          targetIndicator.classList.add('hidden');
          cardHand.classList.remove('hand-active');
        } else {
          selectedCard = card;
          targetIndicator.classList.remove('hidden');
          cardHand.classList.add('hand-active');
        }
        renderMyCards();
        renderPlayers();
      }

      // Mobile touch — select card directly on touch
      let touchedByTouch = false;
      el.addEventListener('touchstart', (e) => {
        e.preventDefault();
        touchedByTouch = true;
        cardHand.classList.add('hand-active');
        document.querySelectorAll('.card-hand-item.card-touched').forEach(c => c.classList.remove('card-touched'));
        el.classList.add('card-touched');
      }, { passive: false });

      el.addEventListener('touchend', (e) => {
        if (!touchedByTouch) return;
        touchedByTouch = false;
        // Only select if finger lifted on the same card (not dragged away)
        const touch = e.changedTouches[0];
        const rect = el.getBoundingClientRect();
        if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
            touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
          selectCard();
        }
      });

      // Desktop click
      el.addEventListener('click', (e) => {
        // Skip if this was a touch interaction (already handled)
        if (e.sourceCapabilities?.firesTouchEvents) return;
        selectCard();
      });

      myCardsEl.appendChild(el);
    });
  }

  // Container-level touch: tapping the hand area reveals cards
  document.getElementById('gp-card-hand').addEventListener('touchstart', () => {
    document.getElementById('gp-card-hand').classList.add('hand-active');
  }, { passive: true });

  // Dismiss card touch & hand on outside tap
  document.addEventListener('touchstart', (e) => {
    const cardHand = document.getElementById('gp-card-hand');
    if (!e.target.closest('#gp-card-hand')) {
      document.querySelectorAll('.card-hand-item.card-touched').forEach(c => c.classList.remove('card-touched'));
      if (!selectedCard) {
        cardHand.classList.remove('hand-active');
      }
    }
  });

  async function playCard(targetId) {
    if (!selectedCard || !gameState) return;
    const card = selectedCard;
    selectedCard = null;
    targetIndicator.classList.add('hidden');
    renderMyCards();
    renderPlayers();

    const token = getToken();
    const res = await fetch(`${apiUrl}/api/games/${gameState.gameId}/play-card`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ cardType: card, targetId }),
    }).catch(() => null);
    if (res?.ok) scheduleStateReload();
  }

  async function endTurn() {
    if (!gameState) return;
    const token = getToken();
    const res = await fetch(`${apiUrl}/api/games/${gameState.gameId}/end-turn`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (res?.ok) {
      scheduleStateReload();
    } else if (res) {
      const body = await res.json().catch(() => null);
      if (body?.error?.includes('attack')) {
        showToast(tMustAttack);
      }
    }
  }

  function showToast(msg) {
    const existing = document.getElementById('gp-toast');
    if (existing) existing.remove();
    const el = document.createElement('div');
    el.id = 'gp-toast';
    el.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 z-50 bg-red-500/90 text-white text-sm font-bold px-4 py-2 rounded-xl shadow-lg';
    el.textContent = msg;
    document.body.appendChild(el);
    setTimeout(() => el.remove(), 2500);
  }

  async function revealIdentity() {
    if (!confirm(tRevealConfirm)) return;
    if (!gameState) return;
    const token = getToken();
    const res = await fetch(`${apiUrl}/api/games/${gameState.gameId}/reveal`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (res?.ok) scheduleStateReload();
  }

  async function sendGameChat() {
    const msg = chatInput.value.trim();
    if (!msg || !gameState) return;
    const me = getMyPlayer();
    if (!isMyTurn() || !me || me.isDead) return;
    const token = getToken();
    const res = await fetch(`${apiUrl}/api/games/${gameState.gameId}/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
      body: JSON.stringify({ message: msg }),
    }).catch(() => null);
    if (res?.ok) {
      chatInput.value = '';
      scheduleStateReload();
    }
  }

  async function leaveGame() {
    if (!gameState) return;
    const me = getMyPlayer();
    if (!me?.isDead) { alert(tLeaveNotAllowed); return; }
    const token = getToken();
    await fetch(`${apiUrl}/api/games/${gameState.gameId}/leave`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    exitToLobby();
  }

  function exitToLobby() {
    gameState = null;
    myPlayerID = null;
    selectedCard = null;
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
    scene.classList.add('hidden');
    scene.classList.remove('flex');
    document.dispatchEvent(new CustomEvent('game:scene', { detail: 'rooms' }));
  }

  function showEffect(targetId, effectType) {
    const playerEl = document.getElementById(`gp-player-${targetId}`);
    if (!playerEl) return;
    const img = effectImages[effectType];
    if (!img) return;

    const rect = playerEl.getBoundingClientRect();
    const containerRect = effectsEl.getBoundingClientRect();
    const x = rect.left - containerRect.left + rect.width / 2 - 24;
    const y = rect.top - containerRect.top + rect.height / 2 - 24;

    const el = document.createElement('img');
    el.src = img;
    el.className = 'absolute w-12 h-12 animate-ping pointer-events-none';
    el.style.left = `${x}px`;
    el.style.top = `${y}px`;
    effectsEl.appendChild(el);
    setTimeout(() => el.remove(), 1000);
  }

  function updateUI() {
    if (!gameState) return;
    turnInfoEl.textContent = `${tTurnInfo} ${gameState.turnCount}/${gameState.maxTurns}`;

    renderPlayers();
    renderMyInfo();
    renderMyCards();
    updateChatState();
  }

  function updateChatState() {
    const me = getMyPlayer();
    const canChat = isMyTurn() && me && !me.isDead && !me.hasChatted;
    chatInput.disabled = !canChat;
    chatSend.disabled = !canChat;
    chatInput.classList.toggle('opacity-40', !canChat);
    chatSend.classList.toggle('opacity-40', !canChat);
    chatSend.classList.toggle('cursor-not-allowed', !canChat);
    chatToggle.classList.toggle('chat-available', canChat);
  }

  function showResult(result) {
    let title = tDraw;
    if (result === 'agent_win') title = tAgentWin;
    else if (result === 'spy_win') title = tSpyWin;

    const me = getMyPlayer();
    let subtitle = '';
    if (me) {
      const myTeamWon = (me.role === 'agent' && result === 'agent_win') ||
                        (me.role === 'spy' && result === 'spy_win');
      subtitle = result === 'draw' ? '' : myTeamWon ? tVictory : tDefeat;
    }

    resultTitle.textContent = title;
    resultTitle.className = `text-3xl font-bold mb-2 ${
      result === 'agent_win' ? 'text-blue-400' :
      result === 'spy_win' ? 'text-red-400' : 'text-amber-400'
    }`;
    resultSubtitle.textContent = subtitle;

    // Show all players with roles
    resultPlayers.innerHTML = '';
    if (gameState?.players) {
      gameState.players.forEach(p => {
        const el = document.createElement('div');
        el.className = 'flex flex-col items-center gap-1';
        el.innerHTML = `
          <img src="${p.avatarUrl || characterSrc}" alt="${p.username}"
            class="w-10 h-10 rounded-full object-cover border-2 ${p.role === 'spy' ? 'border-red-500' : 'border-blue-400'} ${p.isDead ? 'opacity-40 grayscale' : ''}"
            onerror="this.src='${characterSrc}'" />
          <p class="text-white/70 text-xs">${p.username}</p>
          <p class="text-xs ${p.role === 'spy' ? 'text-red-400' : 'text-blue-400'}">${p.role === 'spy' ? tSpy : tAgent}</p>
        `;
        resultPlayers.appendChild(el);
      });
    }

    resultModal.classList.remove('hidden');
    resultModal.classList.add('flex');
  }

  function handleGameEvent(event) {
    if (!gameState) return;

    switch (event.type) {
      case 'game_action': {
        const card = event.card;
        if (card === 'attack') showEffect(event.targetId, 'attack');
        else if (card === 'heal') showEffect(event.targetId, 'heal');
        else if (card === 'jail') showEffect(event.targetId, 'jail');
        break;
      }
      case 'game_chat': {
        const payload = event.payload || {};
        const el = document.createElement('div');
        el.className = 'text-xs';
        el.innerHTML = `<span class="text-amber-400 font-bold">${payload.username || ''}</span>: <span class="text-white/80">${payload.message || ''}</span>`;
        chatMessages.appendChild(el);
        chatMessages.scrollTop = chatMessages.scrollHeight;
        break;
      }
      case 'overflow_discard': {
        const payload = event.payload || {};
        const el = document.createElement('p');
        el.className = 'text-center text-amber-300/60 text-xs my-1';
        el.textContent = `${tOverflowDiscarded}: ${(payload.discarded || []).join(', ')}`;
        chatMessages.appendChild(el);
        break;
      }
    }
  }

  async function loadGameState(gameId) {
    const token = getToken();
    const res = await fetch(`${apiUrl}/api/games/${gameId}/state`, {
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (!res?.ok) return null;
    return await res.json();
  }

  // Listen for game start
  document.addEventListener('game:start', async (e) => {
    const { gameId, userId } = e.detail;
    myPlayerID = userId;

    const state = await loadGameState(gameId);
    if (!state) return;
    gameState = state;

    scene.classList.remove('hidden');
    scene.classList.add('flex');
    document.dispatchEvent(new CustomEvent('game:scene', { detail: 'gameplay' }));

    updateUI();
    startTimerCountdown();
  });

  // Debounced state reload — batch rapid SSE events into one API call
  let reloadTimer = null;
  let pendingGameEnd = null;

  function scheduleStateReload() {
    if (reloadTimer) clearTimeout(reloadTimer);
    reloadTimer = setTimeout(async () => {
      reloadTimer = null;
      if (!gameState) return;
      const state = await loadGameState(gameState.gameId);
      if (!state) return;
      gameState = state;
      updateUI();

      if (state.status === 'finished') {
        const result = pendingGameEnd?.payload?.result || state.result;
        showResult(result);
        if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
        pendingGameEnd = null;
      }
    }, 200);
  }

  // Listen for game events from SSE
  document.addEventListener('game:event', (e) => {
    const event = e.detail;
    if (!gameState) return;

    handleGameEvent(event);

    if (event.type === 'game_end') {
      pendingGameEnd = event;
    }

    if (event.type !== 'game_chat') {
      scheduleStateReload();
    }
  });

  // Listen for scene changes
  document.addEventListener('game:scene', (e) => {
    if (e.detail !== 'gameplay') {
      scene.classList.add('hidden');
      scene.classList.remove('flex');
    }
  });

  // Event handlers
  endTurnBtn.addEventListener('click', endTurn);
  revealBtn.addEventListener('click', revealIdentity);
  leaveBtn.addEventListener('click', leaveGame);
  document.getElementById('gp-end-turn-btn-mobile')?.addEventListener('click', endTurn);
  document.getElementById('gp-reveal-btn-mobile')?.addEventListener('click', revealIdentity);
  document.getElementById('gp-leave-btn-mobile')?.addEventListener('click', leaveGame);
  cancelTargetBtn.addEventListener('click', () => {
    selectedCard = null;
    targetIndicator.classList.add('hidden');
    renderMyCards();
    renderPlayers();
  });
  chatToggle.addEventListener('click', () => {
    chatPanel.classList.toggle('hidden');
    const cardHand = document.getElementById('gp-card-hand');
    const isOpen = !chatPanel.classList.contains('hidden');
    cardHand.classList.toggle('chat-open', isOpen);
    if (isOpen) cardHand.classList.remove('hand-active');
  });
  chatSend.addEventListener('click', sendGameChat);
  chatInput.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing) sendGameChat(); });

  resultLobby.addEventListener('click', () => {
    resultModal.classList.add('hidden');
    resultModal.classList.remove('flex');
    exitToLobby();
  });
  resultReplay.addEventListener('click', () => {
    if (gameState) {
      window.open(`/${lang}/replay?id=${gameState.gameId}`, '_blank');
    }
  });

  // SSE connection status indicator
  const sseDot = document.getElementById('gp-sse-dot');

  document.addEventListener('room:sse', (e) => {
    if (sseDot) {
      switch (e.detail) {
        case 'connected':
          sseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-green-500';
          break;
        case 'reconnecting':
          sseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse';
          break;
        case 'disconnected':
          sseDot.className = 'inline-block w-2.5 h-2.5 rounded-full bg-red-500';
          break;
      }
    }
    // SSE 재연결 시 게임 상태 재동기화: 연결 중 놓친 이벤트를 만회
    if (e.detail === 'connected' && gameState) {
      scheduleStateReload();
    }
  });
</script>
