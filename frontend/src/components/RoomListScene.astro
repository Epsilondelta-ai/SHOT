---
import { type Locale } from '../i18n/locales';
import { useTranslations } from '../i18n';

interface Props {
  apiUrl: string;
  lang: Locale;
}

const { apiUrl, lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="scene-rooms" class="hidden relative z-10 w-full flex-1 flex-col items-center overflow-y-auto py-8 px-4">
  <div class="w-full max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-white font-bold text-lg [text-shadow:_1px_1px_3px_black,_-1px_-1px_3px_black,_1px_-1px_3px_black,_-1px_1px_3px_black]">{t.rooms.title}</h2>
      <div class="flex gap-2">
        <button
          id="refresh-rooms-btn"
          class="bg-white/10 hover:bg-white/20 text-white px-3 py-2 rounded-xl text-sm transition"
          title={t.rooms.refresh}
        >
          <img src="/emoji/counterclockwise-arrows.png" alt="refresh" class="w-5 h-5" />
        </button>
        <button
          id="create-room-btn"
          class="bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold px-4 py-2 rounded-xl text-sm transition"
        >
          {t.rooms.createRoom}
        </button>
      </div>
    </div>
    <div id="room-list" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <p id="room-list-empty" class="text-white/60 text-sm text-center py-6 col-span-3 [text-shadow:_1px_1px_3px_rgba(0,0,0,0.6)]">{t.rooms.empty}</p>
    </div>
  </div>
</div>

<!-- Create Room Modal -->
<div id="create-room-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-6">{t.rooms.createRoomTitle}</h3>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.roomName} <span class="text-red-400">*</span></label>
      <input
        id="room-name-input"
        type="text"
        maxlength="100"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
        placeholder={t.rooms.roomName}
      />
      <p id="room-name-error" class="text-red-400 text-xs mt-1 hidden">{t.rooms.roomNameRequired}</p>
    </div>

    <div class="mb-5">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.maxPlayers}</label>
      <select
        id="room-max-players"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-amber-400"
      >
        {[5, 6, 7, 8, 9, 10, 11, 12].map(n => (
          <option value={n} selected={n === 8}>{n}</option>
        ))}
      </select>
    </div>

    <div class="mb-5">
      <label class="flex items-center gap-2 cursor-pointer select-none">
        <input id="room-private-check" type="checkbox" class="w-4 h-4 accent-amber-400" />
        <span class="text-sm font-semibold text-white/70"><img src="/emoji/locked.png" alt="lock" class="inline-block w-4 h-4" /> {t.rooms.privateRoom}</span>
      </label>
    </div>

    <div id="room-password-field" class="mb-6 hidden">
      <label class="block text-sm font-semibold text-white/70 mb-1">{t.rooms.password} <span class="text-red-400">*</span></label>
      <input
        id="room-password-input"
        type="password"
        maxlength="50"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
        placeholder={t.rooms.password}
      />
      <p id="room-password-error" class="text-red-400 text-xs mt-1 hidden">{t.rooms.passwordRequired}</p>
    </div>

    <div class="flex gap-3">
      <button id="room-create-btn" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.rooms.create}</button>
      <button id="room-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<!-- Join Private Room Modal -->
<div id="join-room-modal" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 px-4">
  <div class="bg-gray-900 rounded-2xl p-8 w-full max-w-md text-white shadow-2xl">
    <h3 class="text-lg font-bold text-amber-400 mb-2"><img src="/emoji/locked.png" alt="lock" class="inline-block w-5 h-5" /> <span id="join-room-name"></span></h3>
    <p class="text-white/50 text-sm mb-6">{t.rooms.enterPassword}</p>
    <div class="mb-6">
      <input
        id="join-password-input"
        type="password"
        maxlength="50"
        class="w-full bg-white/10 border border-white/20 rounded-xl px-4 py-2.5 text-white placeholder-white/30 focus:outline-none focus:ring-2 focus:ring-amber-400"
        placeholder={t.rooms.password}
      />
      <p id="join-password-error" class="text-red-400 text-xs mt-1 hidden">{t.rooms.passwordRequired}</p>
    </div>
    <div class="flex gap-3">
      <button id="join-confirm-btn" class="flex-1 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-2.5 rounded-xl transition">{t.rooms.join}</button>
      <button id="join-cancel-btn" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 rounded-xl transition">{t.common.cancel}</button>
    </div>
  </div>
</div>

<script define:vars={{ apiUrl, tRoomsCreating: t.rooms.creating, tRoomsCreate: t.rooms.create, tStatusWaiting: t.rooms.statusWaiting, tStatusPlaying: t.rooms.statusPlaying, tSpectators: t.rooms.spectators, tBots: t.rooms.bots, tPasswordRequired: t.rooms.passwordRequired, tInvalidPassword: t.rooms.invalidPassword }} is:inline>
  const scene = document.getElementById('scene-rooms');
  const createRoomBtn = document.getElementById('create-room-btn');
  const createRoomModal = document.getElementById('create-room-modal');
  const roomNameInput = document.getElementById('room-name-input');
  const roomNameError = document.getElementById('room-name-error');
  const roomMaxPlayers = document.getElementById('room-max-players');
  const roomCreateBtn = document.getElementById('room-create-btn');
  const roomCancelBtn = document.getElementById('room-cancel-btn');
  const roomList = document.getElementById('room-list');
  const roomListEmpty = document.getElementById('room-list-empty');
  const refreshBtn = document.getElementById('refresh-rooms-btn');
  const privateCheck = document.getElementById('room-private-check');
  const passwordField = document.getElementById('room-password-field');
  const roomPasswordInput = document.getElementById('room-password-input');
  const roomPasswordError = document.getElementById('room-password-error');

  const joinRoomModal = document.getElementById('join-room-modal');
  const joinRoomName = document.getElementById('join-room-name');
  const joinPasswordInput = document.getElementById('join-password-input');
  const joinPasswordError = document.getElementById('join-password-error');
  const joinConfirmBtn = document.getElementById('join-confirm-btn');
  const joinCancelBtn = document.getElementById('join-cancel-btn');

  let pendingRoom = null;

  // Show/hide based on scene events
  document.addEventListener('game:scene', (e) => {
    if (!e.detail || e.detail === 'rooms') {
      scene.classList.remove('hidden');
      scene.classList.add('flex');
    } else {
      scene.classList.add('hidden');
      scene.classList.remove('flex');
    }
  });

  // Toggle password field
  privateCheck.addEventListener('change', () => {
    if (privateCheck.checked) {
      passwordField.classList.remove('hidden');
    } else {
      passwordField.classList.add('hidden');
      roomPasswordInput.value = '';
      roomPasswordError.classList.add('hidden');
    }
  });

  async function loadRooms() {
    const token = localStorage.getItem('token');
    if (!token) return;
    const res = await fetch(`${apiUrl}/api/rooms`, {
      headers: { Authorization: `Bearer ${token}` },
    }).catch(() => null);
    if (!res?.ok) return;
    const rooms = await res.json();
    renderRooms(rooms);
  }

  function statusLabel(status) {
    if (status === 'playing') return tStatusPlaying;
    return tStatusWaiting;
  }

  function statusColor(status) {
    if (status === 'playing') return 'text-yellow-400';
    return 'text-green-400';
  }

  function renderRooms(rooms) {
    roomList.querySelectorAll('.room-card').forEach(el => el.remove());

    if (!rooms || rooms.length === 0) {
      roomListEmpty.classList.remove('hidden');
      return;
    }
    roomListEmpty.classList.add('hidden');

    rooms.forEach(room => {
      const card = document.createElement('div');
      card.className = 'room-card flex items-center gap-3 bg-black/40 hover:bg-black/60 rounded-xl px-4 py-3 cursor-pointer transition';
      card.innerHTML = `
        <div class="flex-1 min-w-0">
          <p class="text-white font-semibold truncate">${room.isPrivate ? '<img src="/emoji/locked.png" alt="lock" class="inline-block w-4 h-4" /> ' : ''}${room.name}</p>
          <p class="${statusColor(room.status)} text-xs">${statusLabel(room.status)}</p>
        </div>
        <div class="flex flex-col items-end gap-0.5 flex-shrink-0 text-xs">
          <span class="text-white/70">👤 ${room.playerCount} / ${room.maxPlayers}</span>
          ${room.botCount > 0 ? `<span class="text-blue-300"><img src="/emoji/robot.png" alt="bot" class="inline-block w-4 h-4" /> ${room.botCount} ${tBots}</span>` : ''}
          ${room.spectatorCount > 0 ? `<span class="text-white/40"><img src="/emoji/eye.png" alt="eye" class="inline-block w-4 h-4" /> ${room.spectatorCount} ${tSpectators}</span>` : ''}
        </div>
      `;
      card.addEventListener('click', async () => {
        const token = localStorage.getItem('token');
        const res = await fetch(`${apiUrl}/api/rooms/${room.id}`, {
          headers: { Authorization: `Bearer ${token}` },
        }).catch(() => null);
        const fresh = res?.ok ? await res.json() : room;
        if (fresh.isPrivate) {
          pendingRoom = fresh;
          joinRoomName.textContent = fresh.name;
          joinPasswordInput.value = '';
          joinPasswordError.classList.add('hidden');
          joinRoomModal.classList.remove('hidden');
          joinRoomModal.classList.add('flex');
          joinPasswordInput.focus();
        } else {
          document.dispatchEvent(new CustomEvent('room:join', { detail: fresh }));
        }
      });
      roomList.appendChild(card);
    });
  }

  // Join private room
  joinConfirmBtn.addEventListener('click', () => {
    const pw = joinPasswordInput.value.trim();
    if (!pw) {
      joinPasswordError.textContent = tPasswordRequired;
      joinPasswordError.classList.remove('hidden');
      return;
    }
    joinPasswordError.classList.add('hidden');
    joinRoomModal.classList.add('hidden');
    joinRoomModal.classList.remove('flex');
    document.dispatchEvent(new CustomEvent('room:join', { detail: { ...pendingRoom, password: pw } }));
    pendingRoom = null;
  });

  joinCancelBtn.addEventListener('click', () => {
    joinRoomModal.classList.add('hidden');
    joinRoomModal.classList.remove('flex');
    pendingRoom = null;
  });

  refreshBtn.addEventListener('click', loadRooms);

  createRoomBtn.addEventListener('click', () => {
    roomNameInput.value = '';
    roomNameError.classList.add('hidden');
    privateCheck.checked = false;
    passwordField.classList.add('hidden');
    roomPasswordInput.value = '';
    roomPasswordError.classList.add('hidden');
    createRoomModal.classList.remove('hidden');
    createRoomModal.classList.add('flex');
  });

  roomCancelBtn.addEventListener('click', () => {
    createRoomModal.classList.add('hidden');
    createRoomModal.classList.remove('flex');
  });

  roomCreateBtn.addEventListener('click', async () => {
    const name = roomNameInput.value.trim();
    if (!name) {
      roomNameError.classList.remove('hidden');
      return;
    }
    roomNameError.classList.add('hidden');

    const isPrivate = privateCheck.checked;
    const password = roomPasswordInput.value.trim();
    if (isPrivate && !password) {
      roomPasswordError.classList.remove('hidden');
      return;
    }
    roomPasswordError.classList.add('hidden');

    const token = localStorage.getItem('token');
    if (!token) return;

    roomCreateBtn.disabled = true;
    roomCreateBtn.textContent = tRoomsCreating;

    const res = await fetch(`${apiUrl}/api/rooms`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`,
      },
      body: JSON.stringify({ name, maxPlayers: parseInt(roomMaxPlayers.value), isPrivate, password }),
    }).catch(() => null);

    roomCreateBtn.disabled = false;
    roomCreateBtn.textContent = tRoomsCreate;

    if (res?.ok) {
      const room = await res.json();
      createRoomModal.classList.add('hidden');
      createRoomModal.classList.remove('flex');
      document.dispatchEvent(new CustomEvent('room:join', { detail: room }));
    }
  });

  // Handle join failure (wrong password or room became private)
  document.addEventListener('room:join:error', (e) => {
    const { room, hadPassword } = e.detail;
    pendingRoom = room;
    joinRoomName.textContent = room.name;
    joinPasswordInput.value = '';
    joinPasswordError.textContent = hadPassword ? tInvalidPassword : tPasswordRequired;
    joinPasswordError.classList.remove('hidden');
    joinRoomModal.classList.remove('hidden');
    joinRoomModal.classList.add('flex');
    joinPasswordInput.focus();
  });

  // Initial load
  loadRooms();
</script>
