---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const tierColors: Record<string, string> = {
  Free: 'bg-gray-100 text-gray-600',
  Basic: 'bg-green-100 text-green-700',
  Standard: 'bg-blue-100 text-blue-700',
  Advanced: 'bg-purple-100 text-purple-700',
  Premium: 'bg-amber-100 text-amber-700',
};
---

<BaseLayout title={`SHOT! - ${t.shop.title}`} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/shop" />

  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-5 py-10">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">{t.shop.title}</h1>
        <p class="text-gray-400">{t.shop.subtitle}</p>
      </div>

      <!-- Credit Packs -->
      <h2 class="text-xl font-bold text-white mb-4">{t.shop.creditPacks}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {t.shop.packs.map(pack => {
          const isMostPopular = 'badge' in pack && pack.badge === 'mostPopular';
          const isBestValue = 'badge' in pack && pack.badge === 'bestValue';
          const borderClass = isMostPopular
            ? 'border-amber-400 ring-2 ring-amber-400/30'
            : isBestValue
              ? 'border-yellow-500 ring-2 ring-yellow-500/30'
              : 'border-gray-700';
          return (
            <div class={`relative bg-gray-900 rounded-2xl p-6 border-2 ${borderClass}`}>
              {isMostPopular && (
                <span class="absolute -top-3 left-4 bg-amber-400 text-black text-xs font-bold px-3 py-1 rounded-full">
                  {t.shop.mostPopular}
                </span>
              )}
              {isBestValue && (
                <span class="absolute -top-3 left-4 bg-yellow-500 text-black text-xs font-bold px-3 py-1 rounded-full">
                  {t.shop.bestValue}
                </span>
              )}
              <h3 class="text-lg font-bold text-white mb-1">{pack.name}</h3>
              <p class="text-3xl font-extrabold text-amber-400 mb-1">
                {pack.credits.toLocaleString()} <span class="text-sm font-normal text-gray-400">{t.shop.credits}</span>
              </p>
              <p class="text-gray-400 text-sm mb-4">{pack.price}</p>
              <button
                disabled
                class="w-full py-2.5 rounded-xl bg-gray-700 text-gray-500 font-semibold cursor-not-allowed text-sm"
                title={t.shop.comingSoon}
              >
                {t.shop.buyNow}
              </button>
              <p class="text-center text-xs text-gray-600 mt-2">{t.shop.comingSoon}</p>
            </div>
          );
        })}
      </div>

      <!-- How Credits Work -->
      <div class="bg-gray-900 rounded-2xl p-6 border border-gray-800 mb-10">
        <h2 class="text-lg font-bold text-white mb-2">{t.shop.howItWorks}</h2>
        <p class="text-gray-400 text-sm">{t.shop.howDesc}</p>
      </div>

      <!-- Model Pricing Table -->
      <h2 class="text-xl font-bold text-white mb-4">{t.shop.modelPricing}</h2>
      <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-800">
              <th class="text-left text-gray-400 font-semibold px-4 py-3">Model</th>
              <th class="text-center text-gray-400 font-semibold px-4 py-3">{t.shop.credits}</th>
              <th class="text-center text-gray-400 font-semibold px-4 py-3">Tier</th>
            </tr>
          </thead>
          <tbody>
            {t.shop.models.map(model => (
              <tr class="border-b border-gray-800/50 last:border-0">
                <td class="text-white px-4 py-3">{model.name}</td>
                <td class="text-center text-amber-400 font-semibold px-4 py-3">{model.cost}</td>
                <td class="text-center px-4 py-3">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${tierColors[model.tier] ?? 'bg-gray-100 text-gray-600'}`}>
                    {model.tier}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>
</BaseLayout>
