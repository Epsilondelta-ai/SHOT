---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const tierColors: Record<string, string> = {
  Free: 'bg-gray-100 text-gray-600',
  Basic: 'bg-green-100 text-green-700',
  Standard: 'bg-blue-100 text-blue-700',
  Advanced: 'bg-purple-100 text-purple-700',
  Premium: 'bg-amber-100 text-amber-700',
};
---

<BaseLayout title={`SHOT! - ${t.shop.title}`} lang={lang} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/shop" />

  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-5 py-10">

      <!-- Header + Credit Balance -->
      <div class="mb-8 flex items-start justify-between gap-4 flex-wrap">
        <div>
          <h1 class="text-3xl font-bold text-white mb-2">{t.shop.title}</h1>
          <p class="text-gray-400">{t.shop.subtitle}</p>
        </div>
        <div id="credit-balance" class="hidden bg-gray-900 border border-gray-700 rounded-xl px-5 py-3 text-right">
          <p class="text-xs text-gray-500 mb-0.5">{t.shop.myCredits}</p>
          <p class="text-2xl font-extrabold text-amber-400"><span id="credit-amount">-</span></p>
        </div>
      </div>

      <!-- Error / Info Banner -->
      <div id="shop-banner" class="hidden mb-6 px-4 py-3 rounded-xl text-sm font-medium"></div>

      <!-- Credit Packs -->
      <h2 class="text-xl font-bold text-white mb-4">{t.shop.creditPacks}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10">
        {t.shop.packs.map((pack, i) => {
          const isMostPopular = 'badge' in pack && pack.badge === 'mostPopular';
          const isBestValue = 'badge' in pack && pack.badge === 'bestValue';
          const borderClass = isMostPopular
            ? 'border-amber-400 ring-2 ring-amber-400/30'
            : isBestValue
              ? 'border-yellow-500 ring-2 ring-yellow-500/30'
              : 'border-gray-700';
          return (
            <div class={`relative bg-gray-900 rounded-2xl p-6 border-2 ${borderClass}`}>
              {isMostPopular && (
                <span class="absolute -top-3 left-4 bg-amber-400 text-black text-xs font-bold px-3 py-1 rounded-full">
                  {t.shop.mostPopular}
                </span>
              )}
              {isBestValue && (
                <span class="absolute -top-3 left-4 bg-yellow-500 text-black text-xs font-bold px-3 py-1 rounded-full">
                  {t.shop.bestValue}
                </span>
              )}
              <h3 class="text-lg font-bold text-white mb-1">{pack.name}</h3>
              <p class="text-3xl font-extrabold text-amber-400 mb-1">
                {pack.credits.toLocaleString()} <span class="text-sm font-normal text-gray-400">{t.shop.credits}</span>
              </p>
              <p class="text-gray-400 text-sm mb-4">{pack.price}</p>
              <button
                class="buy-btn w-full py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-black font-semibold text-sm transition disabled:bg-gray-700 disabled:text-gray-500 disabled:cursor-not-allowed"
                data-pack-index={i}
                data-pack-credits={pack.credits}
                data-buy-label={t.shop.buyNow}
                data-loading-label={t.shop.processing}
                data-login-label={t.shop.loginToBuy}
                data-coming-soon-label={t.shop.comingSoon}
                disabled
              >
                {t.shop.buyNow}
              </button>
            </div>
          );
        })}
      </div>

      <!-- How Credits Work -->
      <div class="bg-gray-900 rounded-2xl p-6 border border-gray-800 mb-10">
        <h2 class="text-lg font-bold text-white mb-2">{t.shop.howItWorks}</h2>
        <p class="text-gray-400 text-sm">{t.shop.howDesc}</p>
      </div>

      <!-- Model Pricing Table -->
      <h2 class="text-xl font-bold text-white mb-4">{t.shop.modelPricing}</h2>
      <div class="bg-gray-900 rounded-2xl border border-gray-800 overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-800">
              <th class="text-left text-gray-400 font-semibold px-4 py-3">Model</th>
              <th class="text-center text-gray-400 font-semibold px-4 py-3">{t.shop.credits}</th>
              <th class="text-center text-gray-400 font-semibold px-4 py-3">Tier</th>
            </tr>
          </thead>
          <tbody>
            {t.shop.models.map(model => (
              <tr class="border-b border-gray-800/50 last:border-0">
                <td class="text-white px-4 py-3">{model.name}</td>
                <td class="text-center text-amber-400 font-semibold px-4 py-3">{model.cost === 0 ? '—' : model.cost}</td>
                <td class="text-center px-4 py-3">
                  <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold ${tierColors[model.tier] ?? 'bg-gray-100 text-gray-600'}`}>
                    {model.tier}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </main>

</BaseLayout>

<script>
  const apiUrl = (import.meta.env.PUBLIC_API_URL as string) ?? 'http://localhost:3000';
  const token = localStorage.getItem('token');
  const lang = window.location.pathname.split('/')[1] || 'ko';

  // pack IDs fetched from backend, indexed by position
  let packIds: string[] = [];

  function showBanner(msg: string, type: 'error' | 'info') {
    const el = document.getElementById('shop-banner')!;
    el.textContent = msg;
    el.className = type === 'error'
      ? 'mb-6 px-4 py-3 rounded-xl text-sm font-medium bg-red-900/50 border border-red-700 text-red-300'
      : 'mb-6 px-4 py-3 rounded-xl text-sm font-medium bg-blue-900/50 border border-blue-700 text-blue-300';
  }

  async function init() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.buy-btn');

    // Load packs from backend (to get IDs)
    try {
      const res = await fetch(`${apiUrl}/api/shop/packs`);
      if (res.ok) {
        const packs: { id: string; credits: number }[] = await res.json();
        // Sort by credits ascending to match frontend order
        packs.sort((a, b) => a.credits - b.credits);
        packIds = packs.map(p => p.id);
      }
    } catch {
      // Backend unreachable — keep buttons disabled
    }

    // Load credit balance if logged in
    if (token) {
      try {
        const res = await fetch(`${apiUrl}/api/credits`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        if (res.ok) {
          const data: { credits: number } = await res.json();
          document.getElementById('credit-amount')!.textContent = data.credits.toLocaleString();
          document.getElementById('credit-balance')!.classList.remove('hidden');
        }
      } catch { /* ignore */ }
    }

    // Configure buttons
    buttons.forEach(btn => {
      const idx = Number(btn.dataset.packIndex);
      const packId = packIds[idx];

      if (!token) {
        btn.textContent = btn.dataset.loginLabel!;
        btn.disabled = false;
        btn.addEventListener('click', () => {
          window.location.href = `/${lang}/login`;
        });
        return;
      }

      if (!packId) {
        btn.textContent = btn.dataset.comingSoonLabel!;
        btn.disabled = true;
        return;
      }

      btn.disabled = false;
      btn.textContent = btn.dataset.buyLabel!;
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = btn.dataset.loadingLabel!;

        try {
          const res = await fetch(`${apiUrl}/api/shop/checkout`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ pack_id: packId }),
          });

          if (res.status === 503) {
            btn.textContent = btn.dataset.comingSoonLabel!;
            btn.disabled = true;
            return;
          }

          if (res.status === 401) {
            window.location.href = `/${lang}/login`;
            return;
          }

          if (!res.ok) {
            const err: { error?: string } = await res.json().catch(() => ({}));
            showBanner(err.error ?? 'An error occurred. Please try again.', 'error');
            btn.disabled = false;
            btn.textContent = btn.dataset.buyLabel!;
            return;
          }

          const data: { checkout_url: string } = await res.json();
          window.location.href = data.checkout_url;
        } catch {
          showBanner('Network error. Please try again.', 'error');
          btn.disabled = false;
          btn.textContent = btn.dataset.buyLabel!;
        }
      });
    });
  }

  init();
</script>
