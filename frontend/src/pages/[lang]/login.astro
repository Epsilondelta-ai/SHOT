---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import character from '../../assets/character.webp';
import SiteHeader from '../../components/SiteHeader.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
---

<BaseLayout title={`SHOT! - ${t.login.title}`} lang={lang} bodyClass="min-h-screen flex flex-col">
  <SiteHeader lang={lang} path="/login" />

  <!-- Background -->
  <HeroBackground class="items-center justify-center" gradient="from-black/60 via-black/10 to-transparent">
    <!-- Login Card + Character -->
    <div class="relative z-10 w-full max-w-3xl mx-auto px-5 py-6 flex items-end justify-center gap-4">
    <!-- Character (desktop only) -->
      <div class="hidden sm:block w-56 flex-shrink-0 self-end pointer-events-none select-none order-2">
        <Image src={character} alt="character" class="w-full drop-shadow-2xl" />
      </div>
      <div class="w-full max-w-md order-1">
        <div class="bg-black/55 backdrop-blur rounded-2xl p-8 shadow-2xl border border-amber-700/30">
          <h2 class="text-2xl font-bold text-center text-amber-300 mb-6">{t.login.title}</h2>

          <form id="login-form" class="flex flex-col gap-4">
            <!-- Email -->
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-amber-200">{t.login.email}</label>
              <input
                type="email"
                name="email"
                class="px-4 py-2.5 bg-black/40 border border-amber-700/50 rounded-lg outline-none focus:border-amber-400 transition text-white placeholder-amber-700"
                required
              />
            </div>

            <!-- Password -->
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-amber-200">{t.login.password}</label>
              <input
                type="password"
                name="password"
                class="px-4 py-2.5 bg-black/40 border border-amber-700/50 rounded-lg outline-none focus:border-amber-400 transition text-white placeholder-amber-700"
                required
              />
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="mt-1 w-full py-3 bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold rounded-lg transition text-base"
            >
              {t.login.submit}
            </button>

            <!-- Error -->
            <p id="login-error" class="hidden text-red-400 text-sm text-center"></p>
          </form>

          <!-- Divider with Google -->
          <div class="flex items-center gap-3 my-4">
            <div class="flex-1 h-px bg-amber-700/50"></div>
            <a
              href={`${apiUrl}/api/auth/google?lang=${lang}`}
              class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow hover:shadow-md transition"
              aria-label="Google Login"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
            </a>
            <div class="flex-1 h-px bg-amber-700/50"></div>
          </div>

          <!-- Sign Up -->
          <a
            href={`/${lang}/signup`}
            class="block w-full py-3 bg-amber-900/50 hover:bg-amber-800/60 text-amber-200 font-bold rounded-lg transition text-base text-center border border-amber-700/40"
          >
            {t.login.signup}
          </a>
        </div>
      </div>
    </div>
  </HeroBackground>

  <script define:vars={{ lang, apiUrl }} is:inline>
    const params = new URLSearchParams(window.location.search);
    const oauthCode = params.get('code');

    if (oauthCode) {
      // Google OAuth flow: exchange one-time code for JWT
      (async () => {
        try {
          const res = await fetch(apiUrl + '/api/auth/exchange', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ code: oauthCode }),
          });
          if (res.ok) {
            const json = await res.json();
            localStorage.setItem('token', json.token);
            window.location.replace('/' + lang);
            return;
          }
        } catch {}
        // Exchange failed — show error, clean URL, stay on login page
        const el = document.getElementById('login-error');
        if (el) {
          el.textContent = 'Google login failed. Please try again.';
          el.classList.remove('hidden');
        }
        window.history.replaceState({}, '', window.location.pathname);
      })();
    } else {
      // Normal login flow
      if (localStorage.getItem('token')) {
        window.location.replace('/' + lang);
      }

      const errorEl = document.getElementById('login-error');

      // Show error redirected from backend (e.g. OAuth state expired)
      if (params.get('error') && errorEl) {
        errorEl.textContent = 'Google login failed. Please try again.';
        errorEl.classList.remove('hidden');
        window.history.replaceState({}, '', window.location.pathname);
      }

      document.getElementById('login-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');
        const form = e.target;
        const data = Object.fromEntries(new FormData(form));
        try {
          const res = await fetch(apiUrl + '/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          const json = await res.json();
          if (res.ok) {
            localStorage.setItem('token', json.token);
            window.location.href = '/' + lang;
          } else {
            errorEl.textContent = json.error || 'Login failed';
            errorEl.classList.remove('hidden');
          }
        } catch {
          errorEl.textContent = 'Network error';
          errorEl.classList.remove('hidden');
        }
      });
    }
  </script>
</BaseLayout>
