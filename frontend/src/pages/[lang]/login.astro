---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<BaseLayout title="SHOT! - Login" bodyClass="bg-gray-900 text-white min-h-screen flex items-center justify-center">
  <div class="w-full max-w-md p-8 bg-gray-800 rounded-xl">
    <h2 class="text-3xl font-bold mb-6 text-center">SHOT!</h2>
    <form id="login-form" class="flex flex-col gap-4">
      <input type="email" name="email" placeholder="Email" class="px-4 py-3 bg-gray-700 rounded-lg outline-none" required />
      <input type="password" name="password" placeholder="Password" class="px-4 py-3 bg-gray-700 rounded-lg outline-none" required />
      <button type="submit" class="px-4 py-3 bg-red-600 hover:bg-red-700 rounded-lg font-semibold transition">
        Login
      </button>
    </form>
  </div>
  <script define:vars={{ lang }}>
    document.getElementById('login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        window.location.href = '/' + lang + '/game';
      }
    });
  </script>
</BaseLayout>
