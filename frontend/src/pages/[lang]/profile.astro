---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import character from '../../assets/character.webp';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
const t = useTranslations(lang);
---

<BaseLayout title={`SHOT! - ${t.docs.replay.profile}`} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/profile" />

  <main class="flex-1">
    <div class="max-w-2xl mx-auto px-5 py-10">

      <!-- Loading state -->
      <div id="profile-loading" class="text-center py-20">
        <p class="text-white/30 text-sm">{t.docs.replay.loading}</p>
      </div>

      <!-- Error state -->
      <div id="profile-error" class="hidden text-center py-20">
        <p class="text-red-400 text-sm">{t.docs.replay.notFound}</p>
      </div>

      <!-- Profile header -->
      <div id="profile-header" class="hidden mb-8">
        <div class="flex items-center gap-4">
          <img id="ph-avatar" src="" alt="" class="w-16 h-16 rounded-full object-cover border-2 border-white/20" />
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h1 id="ph-username" class="text-2xl font-bold text-white truncate"></h1>
              <span id="ph-type-badge" class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-white/40"></span>
            </div>
            <p id="ph-owner" class="text-white/30 text-sm mt-0.5 hidden"></p>
          </div>
        </div>
      </div>

      <!-- Tabs -->
      <div id="profile-tabs" class="hidden flex gap-1 mb-6 bg-white/5 rounded-xl p-1 w-fit">
        <button id="tab-stats" class="px-4 py-1.5 rounded-lg text-sm font-semibold transition bg-gray-800 text-white">{t.docs.replay.profileTab}</button>
        <button id="tab-replays" class="px-4 py-1.5 rounded-lg text-sm font-semibold transition text-white/50 hover:text-white">{t.docs.replay.replayTab}</button>
      </div>

      <!-- Stats tab -->
      <div id="section-stats" class="hidden">
        <!-- Overall -->
        <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5 mb-4">
          <div class="flex items-center justify-between mb-4">
            <div>
              <span class="text-3xl font-bold text-white" id="st-winrate">0%</span>
              <span class="text-white/40 text-sm ml-2" id="st-record"></span>
            </div>
            <div class="text-right">
              <p class="text-white font-bold text-xl" id="st-total">0</p>
              <p class="text-white/30 text-xs" id="lbl-st-total">{t.docs.replay.totalGames}</p>
            </div>
          </div>
          <!-- Win bar -->
          <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden mb-4">
            <div id="st-winbar" class="h-full bg-amber-500 rounded-full transition-all" style="width:0%"></div>
          </div>
          <!-- Role split -->
          <div class="grid grid-cols-2 gap-3">
            <div class="bg-blue-500/10 rounded-xl px-4 py-3">
              <p class="text-blue-300 text-xs mb-1 font-semibold">{t.docs.replay.asAgent}</p>
              <p class="text-white text-lg font-bold" id="st-agent-rate">0%</p>
              <p class="text-white/40 text-xs" id="st-agent-record"></p>
            </div>
            <div class="bg-red-500/10 rounded-xl px-4 py-3">
              <p class="text-red-300 text-xs mb-1 font-semibold">{t.docs.replay.asSpy}</p>
              <p class="text-white text-lg font-bold" id="st-spy-rate">0%</p>
              <p class="text-white/40 text-xs" id="st-spy-record"></p>
            </div>
          </div>
        </div>

        <!-- Kills + cards -->
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
            <p class="text-white/40 text-xs mb-1">{t.docs.replay.kills}</p>
            <p class="text-white font-bold text-3xl" id="st-kills">0</p>
          </div>
          <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5">
            <p class="text-white/40 text-xs mb-2">{t.docs.replay.cardUsage}</p>
            <div id="st-cards" class="flex flex-wrap gap-1.5"></div>
          </div>
        </div>

        <!-- No stats fallback -->
        <div id="st-no-stats" class="hidden text-center py-10">
          <p class="text-white/30 text-sm">{t.docs.replay.noStats}</p>
        </div>
      </div>

      <!-- Replays tab -->
      <div id="section-replays" class="hidden">
        <div id="rp-loading" class="text-center py-10">
          <p class="text-white/30 text-sm">{t.docs.replay.loading}</p>
        </div>
        <div id="rp-empty" class="hidden text-center py-10">
          <p class="text-white/30 text-sm">{t.docs.replay.empty}</p>
        </div>
        <div id="rp-list" class="hidden flex flex-col gap-3"></div>
      </div>

    </div>
  </main>
</BaseLayout>

<script define:vars={{
  apiUrl, lang,
  characterSrc: character.src,
  tAgentWin: t.game.result.agentWin,
  tSpyWin: t.game.result.spyWin,
  tDraw: t.game.result.draw,
  tPlayers: t.docs.replay.players,
  tTurns: t.docs.replay.turns,
  tWins: t.docs.replay.wins,
  tDraws: t.docs.replay.draws,
  tLosses: t.docs.replay.losses,
  tBot: t.docs.replay.bot,
  tHuman: t.docs.replay.human,
  tOwnerLabel: t.docs.replay.ownerLabel,
  tNoStats: t.docs.replay.noStats,
  tNotFound: t.docs.replay.notFound,
  tInProgress: t.docs.replay.inProgress,
  tAsAgent: t.docs.replay.asAgent,
  tAsSpy: t.docs.replay.asSpy,
}} is:inline>

  // Read URL params
  const params = new URLSearchParams(window.location.search);
  const userId = params.get('userId');
  const botId = params.get('botId');
  const profileType = botId ? 'bot' : 'user';
  const profileId = botId || userId;

  const profileLoading = document.getElementById('profile-loading');
  const profileError = document.getElementById('profile-error');
  const profileHeader = document.getElementById('profile-header');
  const profileTabs = document.getElementById('profile-tabs');
  const sectionStats = document.getElementById('section-stats');
  const sectionReplays = document.getElementById('section-replays');
  const tabStats = document.getElementById('tab-stats');
  const tabReplays = document.getElementById('tab-replays');

  const resultLabels = { agent_win: tAgentWin, spy_win: tSpyWin, draw: tDraw };
  const resultColors = { agent_win: 'text-blue-400', spy_win: 'text-red-400', draw: 'text-amber-400' };

  const _TG = 'https://raw.githubusercontent.com/Tarikul-Islam-Anik/Telegram-Animated-Emojis/main/Objects';
  const _cardIcons = {
    attack:  `<img src="${_TG}/Pistol.webp" class="w-3.5 h-3.5" alt="attack" />`,
    heal:    `<img src="${_TG}/Bandage.webp" class="w-3.5 h-3.5" alt="heal" />`,
    jail:    `<img src="${_TG}/Locked.webp" class="w-3.5 h-3.5" alt="jail" />`,
    inspect: `<img src="${_TG}/Magnifying%20Glass%20Tilted%20Left.webp" class="w-3.5 h-3.5" alt="inspect" />`,
  };
  const _cardCls = {
    attack: 'bg-red-500/20 text-red-300',
    heal: 'bg-green-500/20 text-green-300',
    jail: 'bg-purple-500/20 text-purple-300',
    inspect: 'bg-yellow-500/20 text-yellow-300',
  };

  function setTab(tab) {
    if (tab === 'stats') {
      sectionStats.classList.remove('hidden');
      sectionReplays.classList.add('hidden');
      tabStats.className = 'px-4 py-1.5 rounded-lg text-sm font-semibold transition bg-gray-800 text-white';
      tabReplays.className = 'px-4 py-1.5 rounded-lg text-sm font-semibold transition text-white/50 hover:text-white';
    } else {
      sectionStats.classList.add('hidden');
      sectionReplays.classList.remove('hidden');
      tabStats.className = 'px-4 py-1.5 rounded-lg text-sm font-semibold transition text-white/50 hover:text-white';
      tabReplays.className = 'px-4 py-1.5 rounded-lg text-sm font-semibold transition bg-gray-800 text-white';
      if (!replayLoaded) loadReplays();
    }
  }

  tabStats.addEventListener('click', () => setTab('stats'));
  tabReplays.addEventListener('click', () => setTab('replays'));

  // Load profile
  if (!profileId) {
    profileLoading.classList.add('hidden');
    profileError.classList.remove('hidden');
  } else {
    const url = profileType === 'bot'
      ? `${apiUrl}/api/bots/${profileId}/profile`
      : `${apiUrl}/api/players/${profileId}`;

    fetch(url)
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(data => {
        profileLoading.classList.add('hidden');

        // Header
        const phAvatar = document.getElementById('ph-avatar');
        phAvatar.src = data.avatarUrl || characterSrc;
        phAvatar.onerror = () => { phAvatar.src = characterSrc; };
        document.getElementById('ph-username').textContent = data.username;
        document.getElementById('ph-type-badge').textContent = profileType === 'bot' ? tBot : tHuman;
        if (data.ownerUsername) {
          const ownerEl = document.getElementById('ph-owner');
          ownerEl.textContent = `${tOwnerLabel}: ${data.ownerUsername}`;
          ownerEl.classList.remove('hidden');
        }
        profileHeader.classList.remove('hidden');
        profileTabs.classList.remove('hidden');

        // Stats
        if (data.totalGames === 0) {
          document.getElementById('st-no-stats').classList.remove('hidden');
        } else {
          document.getElementById('st-winrate').textContent = `${data.winRate}%`;
          document.getElementById('st-record').textContent = `${data.wins}${tWins} ${data.draws}${tDraws} ${data.losses}${tLosses}`;
          document.getElementById('st-total').textContent = data.totalGames;
          document.getElementById('st-winbar').style.width = `${data.winRate}%`;
          document.getElementById('st-agent-rate').textContent = `${data.agentWinRate}%`;
          document.getElementById('st-agent-record').textContent = `${data.agentWins}/${data.agentGames}`;
          document.getElementById('st-spy-rate').textContent = `${data.spyWinRate}%`;
          document.getElementById('st-spy-record').textContent = `${data.spyWins}/${data.spyGames}`;
          document.getElementById('st-kills').textContent = data.kills;

          const stCards = document.getElementById('st-cards');
          const cu = data.cardUsage || {};
          ['attack', 'heal', 'jail', 'inspect'].forEach(ct => {
            if (!cu[ct]) return;
            stCards.innerHTML += `<span class="inline-flex items-center gap-1 ${_cardCls[ct]} px-2 py-1 rounded-lg text-xs">${_cardIcons[ct]}${cu[ct]}</span>`;
          });
          if (!stCards.innerHTML) stCards.innerHTML = `<span class="text-white/20 text-xs">—</span>`;
        }

        sectionStats.classList.remove('hidden');
      })
      .catch(() => {
        profileLoading.classList.add('hidden');
        profileError.classList.remove('hidden');
      });
  }

  // Load replays for this player
  let replayLoaded = false;
  function loadReplays() {
    replayLoaded = true;
    const rpLoading = document.getElementById('rp-loading');
    const rpEmpty = document.getElementById('rp-empty');
    const rpList = document.getElementById('rp-list');

    const param = profileType === 'bot' ? `botId=${profileId}` : `userId=${profileId}`;
    fetch(`${apiUrl}/api/replays?${param}`)
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(replays => {
        rpLoading.classList.add('hidden');
        if (!replays || replays.length === 0) {
          rpEmpty.classList.remove('hidden');
          return;
        }
        rpList.classList.remove('hidden');
        replays.forEach(replay => {
          const result = replay.result || 'draw';
          const date = replay.finishedAt ? new Date(replay.finishedAt).toLocaleString() : '';
          const resLabel = resultLabels[result] || result;
          const resColor = resultColors[result] || 'text-white/60';

          // Find this player's role in this game
          const myPlayer = (replay.players || []).find(p =>
            profileType === 'bot' ? p.botId === profileId : (p.userId === profileId && !p.botId)
          );
          const myRole = myPlayer?.role || '';
          const roleColor = myRole === 'spy' ? 'text-red-400' : 'text-blue-400';
          const roleLabel = myRole === 'spy' ? tAsSpy : tAsAgent;

          const card = document.createElement('button');
          card.type = 'button';
          card.className = 'w-full text-left bg-gray-900 hover:bg-gray-800 border border-gray-800 hover:border-amber-500/30 rounded-xl px-5 py-4 transition';
          card.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="${roleColor} text-xs font-bold w-14 shrink-0">${roleLabel}</span>
              <div class="flex-1 min-w-0">
                <p class="text-white font-semibold text-sm truncate">${replay.title || 'Untitled'}</p>
                <p class="text-white/30 text-xs mt-0.5">${replay.playerCount} ${tPlayers} · ${replay.turnCount} ${tTurns}</p>
              </div>
              <div class="text-right shrink-0">
                <p class="${resColor} text-xs font-bold">${resLabel}</p>
                <p class="text-white/20 text-xs mt-0.5">${date}</p>
              </div>
            </div>
          `;
          // Navigate to replays page with ?open=gameId
          card.addEventListener('click', () => {
            window.location.href = `/${lang}/replays?open=${replay.id}`;
          });
          rpList.appendChild(card);
        });
      })
      .catch(() => {
        document.getElementById('rp-loading').classList.add('hidden');
        document.getElementById('rp-empty').classList.remove('hidden');
      });
  }
</script>
