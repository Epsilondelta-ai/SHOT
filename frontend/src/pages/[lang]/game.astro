---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameHeader from '../../components/GameHeader.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import { locales, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
---

<BaseLayout title="SHOT!" bodyClass="bg-gray-950 min-h-screen flex flex-col">
  <GameHeader lang={lang} path="/game" />

  <HeroBackground class="flex-1 flex-col justify-center">
  </HeroBackground>

  <script define:vars={{ lang }} is:inline>
    if (!localStorage.getItem('token')) {
      window.location.replace('/' + lang + '/login');
    }
  </script>
</BaseLayout>
