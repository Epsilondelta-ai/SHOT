---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameHeader from '../../components/GameHeader.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import MyPageScene from '../../components/MyPageScene.astro';
import BotsScene from '../../components/BotsScene.astro';
import LobbyMenuScene from '../../components/LobbyMenuScene.astro';
import RoomListScene from '../../components/RoomListScene.astro';
import GameRoomScene from '../../components/GameRoomScene.astro';
import GamePlayScene from '../../components/GamePlayScene.astro';
import loadingImg from '../../assets/loading.webp';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
const t = useTranslations(lang);
---

<BaseLayout title="SHOT!" bodyClass="bg-gray-950 h-dvh flex flex-col overflow-hidden">
  <!-- Loading Screen -->
  <div id="game-loading-screen" class="fixed inset-0 z-[60] hidden flex-col items-center justify-center" style="background: radial-gradient(ellipse at center, #532534 0%, #1a0a10 50%, #0a0408 100%)">
    <img src={loadingImg.src} alt="Loading" class="loading-float w-64 h-64 object-contain mb-10" />
    <div class="w-64 h-3 bg-gray-800 rounded-full overflow-hidden">
      <div id="game-loading-bar" class="h-full bg-amber-400 rounded-full w-0"></div>
    </div>
  </div>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    .loading-float {
      animation: float 2s ease-in-out infinite;
    }
    @keyframes progress-fill {
      from { width: 0%; }
      to { width: 100%; }
    }
    .progress-fill {
      animation: progress-fill 1s ease-in-out forwards;
    }
  </style>

  <GameHeader lang={lang} path="/game" />

  <HeroBackground class="flex-1 flex-col justify-center min-h-0">
    <LobbyMenuScene lang={lang} />
    <RoomListScene apiUrl={apiUrl} lang={lang} />
    <GameRoomScene apiUrl={apiUrl} lang={lang} />
    <GamePlayScene apiUrl={apiUrl} lang={lang} />
    <BotsScene apiUrl={apiUrl} lang={lang} />
    <MyPageScene apiUrl={apiUrl} lang={lang} />
  </HeroBackground>

  <script define:vars={{ lang, apiUrl, tSessionReplaced: t.rooms.sessionReplaced }} is:inline>
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.replace('/' + lang + '/login');
    } else {
      const sessionEs = new EventSource(`${apiUrl}/api/session/sse?token=${token}`);
      sessionEs.addEventListener('message', (e) => {
        try {
          const msg = JSON.parse(e.data);
          if (msg.type === 'session_replaced') {
            sessionEs.close();
            document.dispatchEvent(new CustomEvent('game:session:replaced'));
            alert(tSessionReplaced);
            window.location.replace('/' + lang);
          }
        } catch {}
      });
      window.addEventListener('beforeunload', () => sessionEs.close());

      // Get current user ID for game events — store as promise to avoid race condition
      const currentUserIdPromise = fetch(`${apiUrl}/api/me`, { headers: { Authorization: `Bearer ${token}` } })
        .then(res => res.ok ? res.json() : null)
        .then(user => user?.id ?? null)
        .catch(() => null);

      // Listen for SSE game events and forward to GamePlayScene
      document.addEventListener('room:sse:game', (e) => {
        document.dispatchEvent(new CustomEvent('game:event', { detail: e.detail }));
      });

      // Loading screen helpers
      function showLoadingScreen() {
        const screen = document.getElementById('game-loading-screen');
        const bar = document.getElementById('game-loading-bar');
        bar.classList.remove('progress-fill');
        bar.style.width = '0%';
        screen.classList.remove('hidden');
        screen.classList.add('flex');
        requestAnimationFrame(() => { bar.classList.add('progress-fill'); });
      }
      function hideLoadingScreen() {
        const screen = document.getElementById('game-loading-screen');
        screen.classList.add('hidden');
        screen.classList.remove('flex');
      }

      // GamePlayScene signals it is fully ready (state loaded, scene visible)
      document.addEventListener('game:ready', hideLoadingScreen);

      // Listen for game_start from SSE → show loading, then dispatch to GamePlayScene
      document.addEventListener('room:sse:game_start', (e) => {
        const { gameId } = e.detail;
        showLoadingScreen();
        currentUserIdPromise.then(userId => {
          document.dispatchEvent(new CustomEvent('game:start', {
            detail: { gameId, userId }
          }));
          // hideLoadingScreen is called via game:ready dispatched by GamePlayScene
        });
      });

      // Restore previous room session if the user was already in a room
      fetch(`${apiUrl}/api/me/room`, { headers: { Authorization: `Bearer ${token}` } })
        .then(res => res.ok ? res.json() : null)
        .then(room => {
          if (room) {
            if (room.status === 'playing' && room.gameId) {
              // Reconnect directly to active game with loading screen
              showLoadingScreen();
              document.dispatchEvent(new CustomEvent('room:join', { detail: room }));
              currentUserIdPromise.then(userId => {
                document.dispatchEvent(new CustomEvent('game:start', {
                  detail: { gameId: room.gameId, userId }
                }));
                // hideLoadingScreen is called via game:ready dispatched by GamePlayScene
              });
            } else {
              document.dispatchEvent(new CustomEvent('room:join', { detail: room }));
            }
          }
        })
        .catch(() => {});
    }
  </script>
</BaseLayout>
