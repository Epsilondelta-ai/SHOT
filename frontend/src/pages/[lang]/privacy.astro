---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<BaseLayout title={`SHOT! - ${t.privacy.title}`} lang={lang} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/privacy" />

  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-5 py-10">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">{t.privacy.title}</h1>
        <p class="text-gray-400">{t.privacy.subtitle}</p>
      </div>

      <div class="bg-white rounded-2xl shadow-lg p-8 space-y-6">
        {t.privacy.sections.map(section => (
          <div class="privacy-section" set:html={section} />
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .privacy-section :global(h2) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }
  .privacy-section :global(p) {
    color: #4b5563;
    line-height: 1.75;
  }
</style>
