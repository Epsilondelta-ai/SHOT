---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
---

<BaseLayout title={`SHOT! - ${t.news.title}`} lang={lang} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/news" />

  <main class="flex-1">
    <div class="max-w-3xl mx-auto px-5 py-10">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">{t.news.title}</h1>
        <p class="text-gray-400">{t.news.subtitle}</p>
      </div>

      <p class="text-gray-500 italic">Coming soon...</p>
    </div>
  </main>
</BaseLayout>
