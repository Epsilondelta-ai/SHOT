---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import character from '../../assets/character.webp';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
const t = useTranslations(lang);
---

<BaseLayout title={`SHOT! - ${t.nav.replays}`} bodyClass="min-h-screen flex flex-col bg-gray-950">
  <SiteHeader lang={lang} path="/replays" />

  <HeroBackground>
    <div class="relative z-10">
      <div class="max-w-3xl mx-auto px-5 py-10">
        <h1 class="text-3xl font-bold text-white mb-2">{t.nav.replays}</h1>
        <p class="text-gray-400 mb-6">{t.game.result.watchReplay}</p>

        <!-- Loading -->
        <div id="replays-loading" class="text-center py-10">
          <p class="text-white/40 text-sm">Loading...</p>
        </div>

        <!-- Empty -->
        <div id="replays-empty" class="hidden text-center py-10">
          <p class="text-white/40 text-sm">No replays yet.</p>
        </div>

        <!-- List -->
        <div id="replays-list" class="hidden flex flex-col gap-3"></div>
      </div>
    </div>
  </HeroBackground>
</BaseLayout>

<script define:vars={{ apiUrl, lang, characterSrc: character.src }} is:inline>
  const listEl = document.getElementById('replays-list');
  const loadingEl = document.getElementById('replays-loading');
  const emptyEl = document.getElementById('replays-empty');

  const resultLabels = {
    agent_win: 'Agent Win',
    spy_win: 'Spy Win',
    draw: 'Draw',
  };
  const resultColors = {
    agent_win: 'text-blue-400',
    spy_win: 'text-red-400',
    draw: 'text-amber-400',
  };

  async function loadReplays() {
    try {
      const res = await fetch(`${apiUrl}/api/replays`);
      if (!res.ok) throw new Error();
      const replays = await res.json();

      loadingEl.classList.add('hidden');

      if (!replays || replays.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      listEl.classList.remove('hidden');

      replays.forEach(replay => {
        const result = replay.result || 'draw';
        const date = replay.finishedAt ? new Date(replay.finishedAt).toLocaleString() : '';

        const card = document.createElement('a');
        card.href = `/${lang}/replay?id=${replay.id}`;
        card.className = 'block bg-black/40 hover:bg-black/60 border border-white/10 hover:border-amber-500/30 rounded-xl px-5 py-4 transition';

        // Players avatars
        const avatars = (replay.players || []).slice(0, 8).map(p =>
          `<img src="${p.avatarUrl || characterSrc}" alt="${p.username}"
            class="w-7 h-7 rounded-full object-cover border-2 ${p.role === 'spy' ? 'border-red-500' : 'border-blue-400'} -ml-2 first:ml-0"
            onerror="this.src='${characterSrc}'" title="${p.username} (${p.role})" />`
        ).join('');

        card.innerHTML = `
          <div class="flex items-center gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-bold ${resultColors[result] || 'text-white'} text-sm">${resultLabels[result] || result}</span>
                <span class="text-white/30 text-xs">${replay.playerCount} players</span>
                <span class="text-white/30 text-xs">${replay.turnCount} turns</span>
              </div>
              <div class="flex items-center">
                ${avatars}
              </div>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-white/30 text-xs">${date}</p>
            </div>
          </div>
        `;

        listEl.appendChild(card);
      });
    } catch {
      loadingEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
    }
  }

  loadReplays();
</script>
