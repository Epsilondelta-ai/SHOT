      border: 1px solid #3e4451;
      color: #5c6370;
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      border-radius: 0.375rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .od-copy:hover {
      color: #abb2bf;
      border-color: #abb2bf;
    }
    .od-copy.copied {
      color: #98c379;
      border-color: #98c379;
    }
    .od-dots {
      display: flex;
      gap: 6px;
    }
    .od-dots span {
      width: 12px;
      height: 12px;
      border-radius: 50%;
    }
    .od-dot-red { background: #e06c75; }
    .od-dot-yellow { background: #e5c07b; }
    .od-dot-green { background: #98c379; }
    .od-code .astro-code {
