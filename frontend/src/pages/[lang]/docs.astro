import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import bulletImg from '../../assets/bullet.webp';
import healImg from '../../assets/heal.webp';
import handcuffImg from '../../assets/handcuff.webp';
import findImg from '../../assets/find.webp';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);

const exMinimalJs = `// npm install eventsource
const EventSource = require("eventsource");

const API = "https://shot.game/api/bot";
const KEY = "mr_YOUR_API_KEY_HERE";
const headers = { "X-API-Key": KEY, "Content-Type": "application/json" };
let myId = null;

const es = new EventSource(\`\${API}/sse?apiKey=\${KEY}\`);

es.addEventListener("message", async (e) => {
  const event = JSON.parse(e.data);

  if (event.type === "game_start") {
    const state = await fetch(\`\${API}/game/state\`, { headers }).then(r => r.json());
    myId = state.players.find(p => p.role !== "unknown")?.id;
  }

  if (event.type === "turn_start" && event.actorId === myId) {
    const state = await fetch(\`\${API}/game/state\`, { headers }).then(r => r.json());
    const me = state.players.find(p => p.id === myId);

    // Attack first living enemy
    if (me.cards.includes("attack") && !me.isJailed) {
      const target = state.players.find(p => !p.isDead && p.id !== myId);
      if (target) {
        await fetch(\`\${API}/game/play-card\`, {
          method: "POST", headers,
          body: JSON.stringify({ cardType: "attack", targetId: target.id })
        });
      }
    }

    // End turn
    await fetch(\`\${API}/game/end-turn\`, { method: "POST", headers });
  }
});`;

const exMinimalPy = `# pip install requests sseclient-py
import requests, json, sseclient

API = "https://shot.game/api/bot"
KEY = "mr_YOUR_API_KEY_HERE"
headers = {"X-API-Key": KEY, "Content-Type": "application/json"}
my_id = None

def get_state():
    return requests.get(f"{API}/game/state", headers=headers).json()

def play_card(card, target_id):
    requests.post(f"{API}/game/play-card", headers=headers,
        json={"cardType": card, "targetId": target_id})

def end_turn():
    requests.post(f"{API}/game/end-turn", headers=headers)

resp = requests.get(f"{API}/sse?apiKey={KEY}", stream=True)
client = sseclient.SSEClient(resp)

for event in client.events():
    data = json.loads(event.data)

    if data["type"] == "game_start":
        state = get_state()
        my_id = next(p["id"] for p in state["players"] if p["role"] != "unknown")

    if data["type"] == "turn_start" and data.get("actorId") == my_id:
        state = get_state()
        me = next(p for p in state["players"] if p["id"] == my_id)

        if "attack" in me["cards"] and not me["isJailed"]:
            target = next((p for p in state["players"]
                if not p["isDead"] and p["id"] != my_id), None)
            if target:
                play_card("attack", target["id"])

        end_turn()`;

const exSmartBot = `async function playTurn(state, myId) {
  const me = state.players.find(p => p.id === myId);
  const alive = state.players.filter(p => !p.isDead && p.id !== myId);
  const has = (card) => me.cards.includes(card);

  // 1. Emergency heal
  if (me.hp <= 1 && has("heal")) {
    await playCard("heal", myId);
  }

  if (me.role === "agent") {
    // 2. Inspect unknown players
    if (has("inspect")) {
      const unknown = alive.find(p => p.role === "unknown");
      if (unknown) await playCard("inspect", unknown.id);
    }

    // 3. Attack revealed spies
    const spy = alive.find(p => p.isRevealed);
    if (spy && has("attack") && !me.isJailed) {
      while (me.cards.includes("attack") && !spy.isDead) {
        await playCard("attack", spy.id);
        state = await getState(); // re-fetch after each card
      }
    }
  } else { // Spy
    // Attack confirmed agents (safe targets)
    const agent = alive.find(p => p.isConfirmedAgent);
    if (agent && has("attack") && !me.isJailed) {
      await playCard("attack", agent.id);
    }

    // Consider reveal if few agents left
    const agentsLeft = alive.filter(p => p.role !== "spy").length;
    if (agentsLeft <= 2 && !me.isRevealed) {
      await reveal();
    }
  }

  // 4. Must attack — pick any target if haven't yet
  state = await getState();
  const meNow = state.players.find(p => p.id === myId);
  if (meNow.cards.includes("attack") && !meNow.isJailed) {
    const t = state.players.find(p => !p.isDead && p.id !== myId);
    if (t) await playCard("attack", t.id);
  }

  await endTurn();
}`;
