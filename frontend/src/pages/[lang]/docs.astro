          <p class="text-white/50 text-sm mb-3">{t.docs.examples.smartBotDesc}</p>
          <div class="od-code">
            <div class="od-header">
              <div class="od-dots"><span class="od-dot-red"></span><span class="od-dot-yellow"></span><span class="od-dot-green"></span></div>
              <span style="color:#5c6370;font-size:0.7rem;margin-left:0.5rem;">smart-bot.js</span>
              <button class="od-copy" data-code-id="smartBot">Copy</button>
            </div>
            <Code code={exSmartBot} lang="js" theme="one-dark-pro" />
          </div>
        </div>

        <!-- Example 4: Decision Flowchart -->
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-5">
          <h3 class="text-amber-400 font-bold text-lg mb-2">{t.docs.examples.flowchartTitle}</h3>
          <p class="text-white/50 text-sm mb-5">{t.docs.examples.flowchartDesc}</p>

          <div class="flex flex-col items-center gap-2 text-sm">
            <!-- Start -->
            <div class="bg-amber-500/20 border border-amber-500/40 rounded-xl px-5 py-2 text-amber-400 font-bold text-center">
              turn_start (my turn)
            </div>
            <span class="text-white/20">↓</span>

            <!-- HP check -->
            <div class="bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-2 text-center w-full max-w-sm">
              <p class="text-red-400 text-xs font-semibold">HP ≤ 1 &amp; heal card?</p>
              <div class="flex justify-center gap-8 mt-1">
                <span class="text-green-400 text-xs">YES → heal self</span>
                <span class="text-white/30 text-xs">NO ↓</span>
              </div>
            </div>
            <span class="text-white/20">↓</span>

            <!-- Jailed check -->
            <div class="bg-purple-500/10 border border-purple-500/30 rounded-xl px-4 py-2 text-center w-full max-w-sm">
              <p class="text-purple-400 text-xs font-semibold">Jailed?</p>
              <div class="flex justify-center gap-8 mt-1">
                <span class="text-green-400 text-xs">YES → use heal/inspect/jail only → end turn</span>
                <span class="text-white/30 text-xs">NO ↓</span>
              </div>
            </div>
            <span class="text-white/20">↓</span>

            <!-- Inspect -->
            <div class="bg-blue-500/10 border border-blue-500/30 rounded-xl px-4 py-2 text-center w-full max-w-sm">
              <p class="text-blue-400 text-xs font-semibold">Inspect card &amp; unknown players?</p>
              <div class="flex justify-center gap-8 mt-1">
                <span class="text-green-400 text-xs">YES → inspect unknown</span>
                <span class="text-white/30 text-xs">NO ↓</span>
              </div>
            </div>
            <span class="text-white/20">↓</span>

            <!-- Revealed enemy -->
            <div class="bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-2 text-center w-full max-w-sm">
              <p class="text-red-400 text-xs font-semibold">Revealed enemy exists?</p>
              <div class="flex justify-center gap-8 mt-1">
                <span class="text-green-400 text-xs">YES → attack them</span>
                <span class="text-white/30 text-xs">NO ↓</span>
              </div>
            </div>
            <span class="text-white/20">↓</span>

            <!-- Attack any -->
            <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl px-4 py-2 text-center w-full max-w-sm">
              <p class="text-amber-400 text-xs font-semibold">Attack card available?</p>
              <div class="flex justify-center gap-8 mt-1">
                <span class="text-green-400 text-xs">YES → attack any target</span>
                <span class="text-white/30 text-xs">NO ↓</span>
              </div>
            </div>
            <span class="text-white/20">↓</span>

            <!-- End -->
            <div class="bg-green-500/20 border border-green-500/40 rounded-xl px-5 py-2 text-green-400 font-bold text-center">
              end-turn
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('.docs-tab');
    const panels = document.querySelectorAll<HTMLElement>('.docs-panel');

    function activate(key: string) {
      tabs.forEach(t => {
        const active = t.dataset.tab === key;
        t.className = active
          ? 'docs-tab px-4 py-2.5 text-sm font-semibold rounded-t-lg transition text-amber-400 border-b-2 border-amber-400'
          : 'docs-tab px-4 py-2.5 text-sm font-semibold rounded-t-lg transition text-gray-400 hover:text-white';
      });
      panels.forEach(p => p.classList.toggle('hidden', p.id !== `tab-${key}`));
    }

    tabs.forEach(t => t.addEventListener('click', () => activate(t.dataset.tab!)));
    activate('quickStart');

    document.getElementById('go-to-examples')?.addEventListener('click', () => activate('examples'));
  </script>

  <script define:vars={{ exMinimalJs, exMinimalPy, exSmartBot }} is:inline>
    const codeMap = { minimalJs: exMinimalJs, minimalPy: exMinimalPy, smartBot: exSmartBot };
    document.querySelectorAll('.od-copy').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.codeId;
        const code = codeMap[id];
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 2000);
        } catch {}
      });
    });
  </script>
</BaseLayout>
