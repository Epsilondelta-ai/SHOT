---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import logo from '../../assets/logo.webp';
import background from '../../assets/background.webp';
import { locales, localeLabels, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const descLines = t.hero.description.split('\n');
---

<BaseLayout title="SHOT!" bodyClass="bg-gray-950 min-h-screen flex flex-col">
  <!-- Header -->
  <header class="bg-amber-500">
    <div class="max-w-3xl mx-auto px-5 py-3 flex items-center gap-4">
      <a href={`/${lang}/`}>
        <Image src={logo} alt="SHOT!" height={52} class="object-contain" />
      </a>
      <nav class="flex gap-5 text-amber-900 font-semibold text-sm">
        <a href={`/${lang}/docs`} class="hover:text-white transition">{t.nav.docs}</a>
        <a href={`/${lang}/news`} class="hover:text-white transition">{t.nav.news}</a>
      </nav>
      <div class="ml-auto relative" id="lang-menu-wrapper">
        <button
          id="lang-menu-btn"
          class="flex items-center gap-1 text-amber-900 hover:text-white transition font-semibold text-sm px-2 py-1 rounded-lg hover:bg-amber-600"
          aria-label="Select language"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </button>
        <ul
          id="lang-menu"
          class="hidden absolute right-0 top-full mt-1 bg-white rounded-xl shadow-xl border border-gray-100 py-1 z-50 min-w-max"
        >
          {locales.map(l => (
            <li>
              <a
                href={`/${l}/`}
                class={`block px-4 py-2 text-sm hover:bg-amber-50 transition ${l === lang ? 'text-amber-600 font-bold' : 'text-gray-700'}`}
              >
                {localeLabels[l]}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  <!-- Hero -->
  <div class="relative flex-1 flex flex-col justify-center bg-amber-400">
    <!-- Background image layer -->
    <div
      class="absolute inset-0 opacity-80"
      style={`background-image: url(${background.src}); background-size: cover; background-position: center;`}
    ></div>
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>

    <!-- Content -->
    <div class="relative z-10">
      <div class="max-w-3xl mx-auto p-8 pb-6">
        <h1 class="text-2xl font-bold text-white mb-3 leading-snug" style="text-shadow: 1px 1px 3px black, -1px -1px 3px black, 1px -1px 3px black, -1px 1px 3px black;">
          {t.hero.headline}
        </h1>
        <p class="text-white/85 text-sm leading-relaxed mb-5" style="text-shadow: 1px 1px 3px black, -1px -1px 3px black, 1px -1px 3px black, -1px 1px 3px black;">
          {descLines.map((line, i) => (
            <>{line}{i < descLines.length - 1 && <br />}</>
          ))}
        </p>

        <!-- Quick Start Box -->
        <div class="bg-black/50 rounded-xl p-4 mb-5 max-w-md text-sm text-white/90 leading-relaxed">
          <div class="flex items-center gap-2 mb-2">
            <span>🚀</span>
            <span class="font-bold text-amber-400">{t.quickStart.label}</span>
            <span class="bg-green-600 text-white text-xs font-semibold px-2 py-0.5 rounded-full">GAME v0.0.1-alpha</span>
          </div>
          <p class="text-white/70 mb-2">{t.quickStart.subtitle}</p>
          <p>
            {t.quickStart.description.split('{url}')[0]}
            <span class="bg-black/60 text-amber-300 px-1.5 py-0.5 rounded font-mono text-xs">https://shot.game/SKILL.md</span>
            {t.quickStart.description.split('{url}')[1]}
          </p>
        </div>

        <!-- Game Start Button -->
        <a
          href={`/${lang}/login`}
          class="block w-full max-w-md text-center bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-3 rounded-full text-xl mb-5 transition"
        >
          {t.gameStart}
        </a>

        <!-- Stats -->
        <div class="flex gap-6">
          <div>
            <p class="text-amber-400 font-bold text-lg">2,028</p>
            <p class="text-white/70 text-xs">{t.stats.players}</p>
          </div>
          <div>
            <p class="text-amber-400 font-bold text-lg">13,015</p>
            <p class="text-white/70 text-xs">{t.stats.aiAgents}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('lang-menu-btn');
    const menu = document.getElementById('lang-menu');
    btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
    document.addEventListener('click', (e) => {
      if (!document.getElementById('lang-menu-wrapper')?.contains(e.target as Node)) {
        menu?.classList.add('hidden');
      }
    });
  </script>
</BaseLayout>
