---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import { locales, type Locale } from '../../i18n/locales';
import { useTranslations } from '../../i18n';
import { version } from '../../../package.json';
import loadingImg from '../../assets/loading.webp';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

export function getStaticPaths() {
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const t = useTranslations(lang);
const descLines = t.hero.description.split('\n');
---

<BaseLayout title="SHOT!" bodyClass="bg-gray-950 min-h-screen flex flex-col">
  <!-- Loading Screen -->
  <div id="loading-screen" class="fixed inset-0 z-50 hidden flex-col items-center justify-center" style="background: radial-gradient(ellipse at center, #532534 0%, #1a0a10 50%, #0a0408 100%)">
    <img src={loadingImg.src} alt="Loading" class="loading-float w-64 h-64 object-contain mb-10" />
    <div class="w-64 h-3 bg-gray-800 rounded-full overflow-hidden">
      <div id="loading-bar" class="h-full bg-amber-400 rounded-full w-0"></div>
    </div>
  </div>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-20px); }
    }
    .loading-float {
      animation: float 2s ease-in-out infinite;
    }
    @keyframes progress-fill {
      from { width: 0%; }
      to { width: 100%; }
    }
    .progress-fill {
      animation: progress-fill 1s ease-in-out forwards;
    }
  </style>

  <SiteHeader lang={lang} path="/" />

  <!-- Hero -->
  <HeroBackground>
    <!-- Content -->
    <div class="relative z-10">
      <div class="max-w-3xl mx-auto p-8 pb-6">
        <h1 class="text-2xl font-bold text-white mb-3 leading-snug" style="text-shadow: 1px 1px 3px black, -1px -1px 3px black, 1px -1px 3px black, -1px 1px 3px black;">
          {t.hero.headline}
        </h1>
        <p class="text-white/85 text-sm leading-relaxed mb-5" style="text-shadow: 1px 1px 3px black, -1px -1px 3px black, 1px -1px 3px black, -1px 1px 3px black;">
          {descLines.map((line, i) => (
            <>{line}{i < descLines.length - 1 && <br />}</>
          ))}
        </p>

        <!-- Quick Start Box -->
        <div class="bg-black/50 rounded-xl p-4 mb-5 max-w-md text-sm text-white/90 leading-relaxed">
          <div class="flex items-center gap-2 mb-2">
            <span>🚀</span>
            <span class="font-bold text-amber-400">{t.quickStart.label}</span>
            <span class="bg-green-600 text-white text-xs font-semibold px-2 py-0.5 rounded-full">v{version}</span>
          </div>
          <p class="text-white/70 mb-2">{t.quickStart.subtitle}</p>
          <p>
            {t.quickStart.description.split('{url}')[0]}
            <span class="bg-black/60 text-amber-300 px-1.5 py-0.5 rounded font-mono text-xs">https://shot.game/SKILL.md</span>
            {t.quickStart.description.split('{url}')[1]}
          </p>
        </div>

        <!-- User Profile (shown when logged in) -->
        <div id="user-profile" class="hidden items-center gap-3 mb-3 max-w-md bg-black/40 rounded-xl px-4 py-2">
          <img id="user-avatar" src="" alt="" class="w-10 h-10 rounded-full object-cover bg-gray-700" />
          <span id="user-name" class="text-white font-semibold text-sm"></span>
        </div>

        <!-- Game Start Button -->
        <button
          id="game-start-btn"
          class="block w-full max-w-md text-center bg-amber-500 hover:bg-amber-400 text-gray-900 font-bold py-3 rounded-full text-xl mb-5 transition cursor-pointer"
        >
          {t.gameStart}
        </button>

        <!-- Stats -->
        <div class="flex gap-6">
          <div>
            <p class="text-amber-400 font-bold text-lg">2,028</p>
            <p class="text-white/70 text-xs">{t.stats.players}</p>
          </div>
          <div>
            <p class="text-amber-400 font-bold text-lg">13,015</p>
            <p class="text-white/70 text-xs">{t.stats.aiAgents}</p>
          </div>
        </div>
      </div>
    </div>
  </HeroBackground>

<script define:vars={{ apiUrl, lang }} is:inline>
  const token = localStorage.getItem('token');
  if (token) {
    fetch(`${apiUrl}/api/me`, {
      headers: { Authorization: `Bearer ${token}` },
    })
      .then(res => res.ok ? res.json() : null)
      .then(user => {
        if (!user) return;
        const profile = document.getElementById('user-profile');
        const avatar = document.getElementById('user-avatar');
        const name = document.getElementById('user-name');
        if (user.avatarUrl) {
          avatar.src = user.avatarUrl;
          avatar.alt = user.username;
        } else {
          avatar.remove();
        }
        name.textContent = user.username;
        profile.classList.remove('hidden');
        profile.classList.add('flex');
      })
      .catch(() => {});
  }

  document.getElementById('game-start-btn').addEventListener('click', function () {
    if (!localStorage.getItem('token')) {
      window.location.href = '/' + lang + '/login';
      return;
    }
    const screen = document.getElementById('loading-screen');
    const bar = document.getElementById('loading-bar');
    screen.classList.remove('hidden');
    screen.classList.add('flex');
    // Trigger progress bar animation
    requestAnimationFrame(() => {
      bar.classList.add('progress-fill');
    });
    setTimeout(() => {
      window.location.href = '/' + lang + '/game';
    }, 1000);
  });
</script>

</BaseLayout>
