---
import loadingImg from '../assets/loading.webp';
import background from '../assets/background.webp';
import background2 from '../assets/background2.webp';
import character from '../assets/character.webp';
import logo from '../assets/logo.webp';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SHOT!</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Preload font -->
  <link rel="preload" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />

  <!-- Preload key images used on landing/game pages -->
  <link rel="preload" as="image" href={loadingImg.src} />
  <link rel="preload" as="image" href={background.src} />
  <link rel="preload" as="image" href={background2.src} />
  <link rel="preload" as="image" href={character.src} />
  <link rel="preload" as="image" href={logo.src} />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%;
      background: radial-gradient(ellipse at center, #532534 0%, #1a0a10 50%, #0a0408 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .loader {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .loading-float {
      width: 256px;
      height: 256px;
      object-fit: contain;
      margin-bottom: 40px;
      animation: float 2s ease-in-out infinite;
    }
    .bar-track {
      width: 256px;
      height: 12px;
      background: #1f2937;
      border-radius: 9999px;
      overflow: hidden;
    }
    .bar-fill {
      height: 100%;
      background: #fbbf24;
      border-radius: 9999px;
      animation: progress 1.5s ease-in-out infinite alternate;
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-20px); }
    }
    @keyframes progress {
      from { width: 20%; }
      to   { width: 85%; }
    }
  </style>
</head>
<body>
  <div class="loader">
    <img class="loading-float" src={loadingImg.src} alt="Loading" />
    <div class="bar-track"><div class="bar-fill"></div></div>
  </div>
  <script>
    const supported = ['ko', 'en', 'zh-cn', 'ja', 'es', 'pt-br', 'fr', 'ru', 'de'];
    const lang = navigator.language.toLowerCase();
    const matched = supported.find(l => lang.startsWith(l.replace('-', '_')) || lang.startsWith(l.split('-')[0]));
    window.location.replace('/' + (matched ?? 'en') + '/');
  </script>
</body>
</html>
