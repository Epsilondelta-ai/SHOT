# ── Database ───────────────────────────────────────────────────
DB_USER=shot
DB_PASSWORD=shot
DB_NAME=shot
# DB_HOST and DB_PORT are set automatically by docker-compose
# (overridden to "postgres" / "5432" in the backend service)

# ── Auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret

# ── Google OAuth (optional — leave blank to disable) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ───────────────────────────────────────────────────────
# Public URL of the frontend — must include https:// in production.
# Used for: CORS AllowOrigins (must match browser Origin header exactly)
#           Google OAuth redirect after login
# Production:  FRONTEND_URL=https://shot.game
# Development: FRONTEND_URL=http://localhost
FRONTEND_URL=http://localhost

# Public URL of the backend — must include https:// in production.
# Used for: Google OAuth redirect_uri construction
#           (/api/auth/google/callback is appended automatically)
# Register https://shot.game/api/auth/google/callback in Google Cloud Console.
# In same-domain nginx setup, BACKEND_URL == FRONTEND_URL (both are shot.game).
# Production:  BACKEND_URL=https://shot.game
# Development: BACKEND_URL=http://localhost:3000
BACKEND_URL=http://localhost

# PUBLIC_API_URL is baked into the frontend at build time.
# Leave empty to use relative paths (/api/...) — recommended when
# the frontend and backend are served from the same domain via nginx.
# Set to your backend's full URL only when they are on different domains.
PUBLIC_API_URL=

# ── Paddle Payment ─────────────────────────────────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# ── Production (docker-compose.prod.yml + init-letsencrypt.sh) ─
# Domain name for SSL certificate (must point to this server's IP)
DOMAIN=shot.example.com

# Email for Let's Encrypt expiry notifications (optional but recommended)
CERTBOT_EMAIL=admin@example.com

# Set to 1 to use Let's Encrypt staging (for testing — avoids rate limits)
STAGING=0
