# ── Database ───────────────────────────────────────────────────
DB_USER=shot
DB_PASSWORD=shot
DB_NAME=shot
# DB_HOST and DB_PORT are set automatically by docker-compose
# (overridden to "postgres" / "5432" in the backend service)

# ── Auth ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_secret

# ── Google OAuth (optional — leave blank to disable) ───────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── URLs ───────────────────────────────────────────────────────
# Public URL of the frontend (used for CORS and OAuth redirect)
# Example: https://shot.example.com  or  http://localhost
FRONTEND_URL=http://localhost

# Public URL of the backend (used for Google OAuth callback URL)
# Example: https://api.shot.example.com  or  http://localhost
BACKEND_URL=http://localhost

# PUBLIC_API_URL is baked into the frontend at build time.
# Leave empty to use relative paths (/api/...) — recommended when
# the frontend and backend are served from the same domain via nginx.
# Set to your backend's full URL only when they are on different domains.
PUBLIC_API_URL=
